parameters {
	MORTALITY_ENGINE	MortalityEngine = MORTALITY_ENGINE_MPORT_V2; //EN Mortality engine/model
	int	MinLife = 0; //EN Minimum number of years of life
	int	MaxLife = 110; //EN Maximum number of years of life
	int	MaxYear = 2051; //EN Year simulation ends
	MORTALITY_PROJECTION	MortProjectionScenario = MORT_MID; //EN Period mortality projection scenario corresponding to Low, Medium or High life expectancy
	logical	MortHazardExtrapolationFlag = FALSE; //EN extrapolate period mortality rates beyond update period?
/* NOTE ( MortHazard, EN )
	   These parameters were derived from cohort life tables published in "New Birth Cohort Life Tables for Canada 
	   and Quebec, 1801-1991" by Robert Bourbeau, Jacques Legare and Valerie Emond, Statistics Canada Catalog 91F0015MPE.
	   The published abridged (5 year) life tables were the source of cumulative hazard estimates. Single year hazards
	   were obtained by differencing single year estimates of the cumulative hazards which, in turn, were obtained by
	   clamped, cubic-spline interpolation of the abridged cumulative hazards.
	   
	   Incomplete cohort life tables were first projected using mortality assumptions from the Statistics Canada Medium population projections
	   for the period 2000-2026.  Cohort life tables that are still incomplete (i.e., in the period after 2026) have been extrapolated using
	   the average rate of mortality improvement - by sex - from the projection period 2000-2026.  Mortality remains fixed at the levels of the 
	   2026 birth cohort for all cohorts born after 2026.
*/


