parameters {
	/* NOTE ( HUI_at_os_beta_age, EN )
	Value of beta for age category used for computation of delta HUI due to 1st or last visit to OS
	To remove computation of new HUI at OS, set this parameter to 0
	From Jacek's team
*/


	 //EN Value of beta for age category used for computation of delta HUI due to 1st or last visit to OS
	double	HUI_at_os_beta_age[HUI_AGE_GROUPB] = {
		0.2988, 0.2625, 0.1897, 0, 
	};
/* NOTE ( HUI_at_os_beta_int, EN )
	Value of intercept used for computation of delta HUI due to 1st or last visit to OS
	To remove computation of new HUI at OS, set this parameter to 0
	From Jacek's team
*/

	double	HUI_at_os_beta_int = 0.2828; //EN Value of intercept used for computation of delta HUI due to 1st or last visit to OS
/* NOTE ( HUI_at_os_beta_scale, EN )
	Represents the random noise for model of HUI at os. 
	From Jacek's team
*/

