#include "pohem.h"
//FILE_LABEL (EN) AMI_CVDPoRT
/* FILE_NOTE(EN)

This file implements cardiovascular (AMI) disease incidence calculation using the CVDPoRT algorithm.
*/

// Customized "include"
// Structure of MPP Files
// classifications, ranges, partitions
// Parameters
// Person state variable declarations
// (functions)
// Person Events
// Presimulation code

// AMI

classification CVDPORT_MAIN_TERMS{	//EN CVDPoRT V2 risk algorithm main terms (non-cubic spline)


	CVDPORT_MAIN_SMOKER_CURRENT,           //EN Current smoker
	CVDPORT_MAIN_SMOKER_FORMER_LT5,        //EN Former smoker quit less than 5 years ago
	CVDPORT_MAIN_SMOKER_FORMER_GT5,        //EN Former smoker quit 5 years ago or more
	CVDPORT_MAIN_DRINK_FORMER,             //EN Former drinker
	CVDPORT_MAIN_HYPERTENSION,             //EN Has hypertension
	CVDPORT_MAIN_DIABETES,                 //EN Has diabetes

	CVDPORT_MAIN_EDUC_HIGH_SCHOOL_GRAD,    //EN High school grad
	CVDPORT_MAIN_EDUC_SOME_PS,             //EN Some post-secondary education
	CVDPORT_MAIN_EDUC_PS_GRAD             //EN Post-secondary grad
};



classification CVDPORT_INTERACTION_TERMS{	//EN CVDPoRT risk algorithm interaction coefficients 


	CVDPORT_INTER_AGE_SMOKER_CURRENT,       //EN Interaction Age * current smoker
	CVDPORT_INTER_AGE_SMOKER_FORMER_LT5,    //EN Interaction Age * former smoker quit less than 5 years ago
	CVDPORT_INTER_AGE_SMOKER_FORMER_GT5,    //EN Interaction Age * former smoker quit 5 years ago or more
	CVDPORT_INTER_AGE_DRINK_FORMER,         //EN Interaction Age * former drinker
	CVDPORT_INTER_AGE_HYPERTENSION,         //EN Interaction Age * hypertension
	CVDPORT_INTER_AGE_DIABETES,             //EN Interaction Age * diabetes

	/*November 20th 2019- These interaction terms were introduced to ensure the presim section of the code worked properly- DH- Gitlab issue #25 for more details*/

	CVDPORT_INTER_AGE_EDUC_HIGH_SCHOOL_GRAD,    //EN Interaction Age * high school grad
	CVDPORT_INTER_AGE_EDUC_SOME_PS,             //EN Interaction Age * some post-secondary education
	CVDPORT_INTER_AGE_EDUC_PS_GRAD,             //EN Interaction Age * post-secondary grad

	CVDPORT_INTER_AGE_PACK_YEARS,           //EN Interaction Age * pack years
	CVDPORT_INTER_AGE_DRINKS_LAST_WEEK,     //EN Interaction Age * drinks last week
	CVDPORT_INTER_AGE_PA_MET,               //EN Interaction Age * physical activity MET
	CVDPORT_INTER_AGE_BMI					//EN Interaction Age * BMI


};

classification CVDPORT_AMI_STATE{	//EN CVDPoRT AMI state
	CVDPORT_AMI_NO,						//EN No AMI
	CVDPORT_AMI_YES                   //EN AMI

};
parameter_group pgAMI_CVDPoRT{		//EN Acute Myocardial Infarction (AMI) modelled with CVDPoRT
	CvdportAmiBaseline,
	CvdportAmiLogBaseCumulativeHazard,
	CvdportAmiMainTermsMeans,
	CvdportAmiMainTermsCoefficients,
	CvdportAmiInteractionCoefficients,
	CvdportAmiAgeSplineLocationCoef,
	CvdportAmiAgeSplineCompanion,
	CvdportAmiPackYearsSplineLocationCoef,
	CvdportAmiPackYearsSplineCompanion,
	CvdportAmiDrinksSplineLocationCoef,
	CvdportAmiDrinksSplineCompanion,
	CvdportAmiMetsSplineLocationCoef,
	CvdportAmiMetsSplineCompanion,
	CvdportAmiBmiSplineLocationCoef,
	CvdportAmiBmiSplineCompanion,
	CVDportAmiAlterationSpecs,
	CVDportAmiAlterationSpecsBeforeSlope,
	CVDportAmiAlterationSpecsAfterSlope,
	CVDportAmiTemporalBendingPoint,
	CVDportAmiAlterationSpecsAppliesToPrevalenceFixSR ,
	pgAMI_CVDPoRT_Calibration_Inputs

};



parameters{

double  CvdportAmiLogBaseCumulativeHazard[SEX][COORDINATES_X_Y][SCATTER_PLOT_ELEMENTS];//EN CVDPoRT-AMI log baseline cumulative hazard	
double  CvdportAmiBaseline[SEX]; //EN CVDPoRT-AMI 5 year baseline cumulative hazard
double	CvdportAmiMainTermsMeans[SEX][CVDPORT_MAIN_TERMS]; //EN CVDPoRT-AMI main non-spline terms means 
double	CvdportAmiMainTermsCoefficients[SEX][CVDPORT_MAIN_TERMS]; //EN CVDPoRT-AMI main non-spline terms coefficients
double	CvdportAmiInteractionCoefficients[SEX][CVDPORT_INTERACTION_TERMS]; //EN CVDPoRT-AMI interaction terms

double  CvdportAmiAgeSplineLocationCoef[SEX][CUBIC_SPLINE_KNOTS_LOCATION_COEFFICIENT][CUBIC_SPLINE_KNOTS_INDEX];  //EN CVDPoRT-AMI age cubic spline coefficients 
double  CvdportAmiAgeSplineCompanion[SEX][CUBIC_SPLINE_COMPANION];                                             //EN CVDPoRT-AMI age cubic spline companion 

double  CvdportAmiPackYearsSplineLocationCoef[SEX][CUBIC_SPLINE_KNOTS_LOCATION_COEFFICIENT][CUBIC_SPLINE_KNOTS_INDEX];  //EN CVDPoRT-AMI pack years cubic spline coefficients 
double  CvdportAmiPackYearsSplineCompanion[SEX][CUBIC_SPLINE_COMPANION];                                             //EN CVDPoRT-AMI pack years cubic spline companion 

double  CvdportAmiDrinksSplineLocationCoef[SEX][CUBIC_SPLINE_KNOTS_LOCATION_COEFFICIENT][CUBIC_SPLINE_KNOTS_INDEX];  //EN CVDPoRT-AMI drinks last week cubic spline coefficients 
double  CvdportAmiDrinksSplineCompanion[SEX][CUBIC_SPLINE_COMPANION];                                             //EN CVDPoRT-AMI drinks last week cubic spline companion 

double  CvdportAmiMetsSplineLocationCoef[SEX][CUBIC_SPLINE_KNOTS_LOCATION_COEFFICIENT][CUBIC_SPLINE_KNOTS_INDEX];  //EN CVDPoRT-AMI METs cubic spline coefficients 
double  CvdportAmiMetsSplineCompanion[SEX][CUBIC_SPLINE_COMPANION];                                             //EN CVDPoRT-AMI METs cubic spline companion 

double  CvdportAmiBmiSplineLocationCoef[SEX][CUBIC_SPLINE_KNOTS_LOCATION_COEFFICIENT][CUBIC_SPLINE_KNOTS_INDEX];  //EN CVDPoRT-AMI BMI cubic spline coefficients 
double  CvdportAmiBmiSplineCompanion[SEX][CUBIC_SPLINE_COMPANION];                                             //EN CVDPoRT-AMI BMI cubic spline companion 

double  CVDportAmiAlterationSpecs[SEX][FROM_25_TO_90_BY_5];    //EN Alteration of CVDPoRT-AMI log hazard by sex and age
logical CVDportAmiAlterationSpecsAppliesToPrevalenceFixSR;    //EN Use altered CVDPoRT-AMI log hazard in correction for initial AMI prevalence

int  CVDportAmiTemporalBendingPoint; //EN Label for CVDportAmiTemporalBendingPoint

double  CVDportAmiAlterationSpecsBeforeSlope[SEX][FROM_25_TO_90_BY_5];    //EN Label for CVDportAmiAlterationSpecsBeforeSlope
double  CVDportAmiAlterationSpecsAfterSlope[SEX][FROM_25_TO_90_BY_5];    //EN Label for CVDportAmiAlterationSpecsAfterSlope

model_generated double mgCvdportAmiSumMainTermsCoefMeanCovariate[SEX];
model_generated double mgCvdportAmiSumInteractionCoefMeanCovariate[SEX];

};

//hide(pgAMI_CVDPoRT);

actor Person            // Core Individual
{
double gBMI4_cvdport_ami = gBMI_PHAC;


double cvdport_ami_spline_age = UpdateCvdportAmiSplineAge(lifespan_age, sex, acute_myocardial_infract);
double cvdport_ami_spline_bmi = UpdateCvdportAmiSplineBmi(gBMI4_cvdport_ami, sex, acute_myocardial_infract);
double cvdport_ami_spline_pack_years = UpdateCvdportAmiSplinePackYears(total_packyears_smoked, sex, acute_myocardial_infract);
double cvdport_ami_spline_alcohol = UpdateCvdportAmiSplineAlcohol(number_drinks_past_week, sex, acute_myocardial_infract); // icitte will need to make number_drinks_past_week dynamic
double cvdport_ami_spline_met = UpdateCvdportAmiSplineMet(physical_activity_met, sex, acute_myocardial_infract);


CVDPORT_AMI_STATE acute_myocardial_infract; //EN Acute myocaridal infraction (CVDPoRT AMI)
CVDPORT_AMI_STATE acute_myocardial_infract_initial; //EN Acute myocaridal infraction status at start
CVDPORT_AMI_STATE acute_myocardial_infract_initial_altered; //EN Acute myocaridal infraction status altered at start (static afterwards)

event   timeCvdportAmiDiseaseEvent, CvdportAmiDiseaseEvent; // , 0;  //  default low priority    


void	ReadFromStartPopAMI();
hook    ReadFromStartPopAMI, ReadFromStartPop, 72; // 72 = execution number, the higher the value, the later the execution
};


void hook_ReadFromStartPopAMI() {};

void Person::ReadFromStartPopAMI()
{
	//MessageWhoWhenWhere(__FUNCTION__, 4 == 4);
	const double *record_to_be_read;
	record_to_be_read = FictivePersonCharacteristics[ROW_1][cDb_Weight] < 0.0 ? pStartPop[cchs_record] : FictivePersonCharacteristics[ROW_1];

	acute_myocardial_infract = (CVDPORT_AMI_STATE) int(record_to_be_read[cDb_HeartAttack]);
	acute_myocardial_infract_initial = (CVDPORT_AMI_STATE) int(record_to_be_read[cDb_HeartAttack]);
	acute_myocardial_infract_initial_altered = (CVDPORT_AMI_STATE) int(record_to_be_read[cDb_HeartAttack]);

	hook_ReadFromStartPopAMI();
};




// This code udpates the splines

double UpdateCvdportAmiSplineAge(int    x, SEX sexe, CVDPORT_AMI_STATE ami)
{
	return ami == CVDPORT_AMI_YES ? 0.0:
		CubicSpline((int)x, (double*)CvdportAmiAgeSplineLocationCoef[sexe][CUBIC_SPLINE_KNOTS_LOCATION],
			(double*)CvdportAmiAgeSplineLocationCoef[sexe][CUBIC_SPLINE_KNOTS_COEFFICIENT],
			(double*)CvdportAmiAgeSplineCompanion[sexe]);
};

double UpdateCvdportAmiSplineBmi(double x, SEX sexe, CVDPORT_AMI_STATE ami)
{
	return ami == CVDPORT_AMI_YES ? 0.0 : 
		CubicSpline((double)x, (double*)CvdportAmiBmiSplineLocationCoef[sexe][CUBIC_SPLINE_KNOTS_LOCATION],
			(double*)CvdportAmiBmiSplineLocationCoef[sexe][CUBIC_SPLINE_KNOTS_COEFFICIENT],
			(double*)CvdportAmiBmiSplineCompanion[sexe]);
};

double UpdateCvdportAmiSplinePackYears(double x, SEX sexe, CVDPORT_AMI_STATE ami)
{
	return ami == CVDPORT_AMI_YES ? 0.0 : 
		CubicSpline((double)x, (double*)CvdportAmiPackYearsSplineLocationCoef[sexe][CUBIC_SPLINE_KNOTS_LOCATION],
			(double*)CvdportAmiPackYearsSplineLocationCoef[sexe][CUBIC_SPLINE_KNOTS_COEFFICIENT],
			(double*)CvdportAmiPackYearsSplineCompanion[sexe]);
};

double UpdateCvdportAmiSplineAlcohol(int    x, SEX sexe, CVDPORT_AMI_STATE ami)
{
	return ami == CVDPORT_AMI_YES ? 0.0 : 
		CubicSpline((int)x, (double*)CvdportAmiDrinksSplineLocationCoef[sexe][CUBIC_SPLINE_KNOTS_LOCATION],
			(double*)CvdportAmiDrinksSplineLocationCoef[sexe][CUBIC_SPLINE_KNOTS_COEFFICIENT],
			(double*)CvdportAmiDrinksSplineCompanion[sexe]);
};

double UpdateCvdportAmiSplineMet(double x, SEX sexe, CVDPORT_AMI_STATE ami)
{
	return ami == CVDPORT_AMI_YES ? 0.0 : 
		CubicSpline((double)x, (double*)CvdportAmiMetsSplineLocationCoef[sexe][CUBIC_SPLINE_KNOTS_LOCATION],
			(double*)CvdportAmiMetsSplineLocationCoef[sexe][CUBIC_SPLINE_KNOTS_COEFFICIENT],
			(double*)CvdportAmiMetsSplineCompanion[sexe]);
};





TIME Person::timeCvdportAmiDiseaseEvent()
{
	TIME time_next = TIME_INFINITE;

	//if (acute_myocardial_infract== CVDPORT_AMI_NO)
	if (TRUE) // To investigate flipping performed by AMI_CVDPoRT_PrevalenceStart.mpp   icitte
	{

		const double *main_coefs = CvdportAmiMainTermsCoefficients[sex];
		const double *interactions = CvdportAmiInteractionCoefficients[sex];

		double hazard;
		//BEGIN Step 1: sum_k   coef_k * (age - mean_age ) * (Xk - mean_Xk)  =  (age - mean_age ) * ( sum_k   coef_k  * Xk -  sum_k   coef_k  * mean_Xk  )
		hazard = interactions[CVDPORT_INTER_AGE_SMOKER_CURRENT] * (smoking_status4 == LIGHT_smoker || smoking_status4 == HEAVY_smoker)
			+ interactions[CVDPORT_INTER_AGE_SMOKER_FORMER_LT5] * (smoking_status4 == FORMER_smoker)*(time_since_quit_smoking < 4)
			+ interactions[CVDPORT_INTER_AGE_SMOKER_FORMER_GT5] * (smoking_status4 == FORMER_smoker)*(time_since_quit_smoking >= 4)
			+ interactions[CVDPORT_INTER_AGE_PACK_YEARS] * total_packyears_smoked
			+ interactions[CVDPORT_INTER_AGE_DRINK_FORMER] * (gAlcohol5 == ALCOHOL_FORMER)
			+ interactions[CVDPORT_INTER_AGE_DRINKS_LAST_WEEK] * number_drinks_past_week
			+ interactions[CVDPORT_INTER_AGE_PA_MET] * physical_activity_met
			+ interactions[CVDPORT_INTER_AGE_BMI] * gBMI4_cvdport_ami
			+ interactions[CVDPORT_INTER_AGE_HYPERTENSION] * (gBP_PA == HIGH_BP_YES)
			+ interactions[CVDPORT_INTER_AGE_DIABETES] * (gDiabetes_use == DIAB_YES);


		hazard = hazard - mgCvdportAmiSumInteractionCoefMeanCovariate[sex];   // got ( sum_k   coef_k  * Xk -  sum_k   coef_k  * mean_Xk  )  so far
		hazard *= (lifespan_age - CvdportAmiAgeSplineCompanion[sex][CUBIC_SPLINE_COMPANION_CENTER_LINEAR_TERM]);  //CvdportAmiAgeSplineCompanion[sex][..] contains mean age
																												  //END Step 1: sum_k   coef_k * (age - mean_age ) * (Xk - mean_Xk)  =  (age - mean_age ) * ( sum_k   coef_k  * Xk -  sum_k   coef_k  * mean_Xk  )

																												  //BEGIN Step 2: add on sum_k   coef_k *  (Xk - mean_Xk)  =   ( sum_k   coef_k  * Xk -  sum_k   coef_k  * mean_Xk  ) over main terms (interactions and splines excluded)
		hazard = hazard
			+ main_coefs[CVDPORT_MAIN_SMOKER_CURRENT] * (smoking_status4 == LIGHT_smoker || smoking_status4 == HEAVY_smoker)
			+ main_coefs[CVDPORT_MAIN_SMOKER_FORMER_LT5] * (smoking_status4 == FORMER_smoker)*(time_since_quit_smoking <  4)
			+ main_coefs[CVDPORT_MAIN_SMOKER_FORMER_GT5] * (smoking_status4 == FORMER_smoker)*(time_since_quit_smoking >= 4)
			+ main_coefs[CVDPORT_MAIN_DRINK_FORMER] * (gAlcohol5 == ALCOHOL_FORMER)
			+ main_coefs[CVDPORT_MAIN_EDUC_HIGH_SCHOOL_GRAD] * (gEducation == EDUC2)
			+ main_coefs[CVDPORT_MAIN_EDUC_SOME_PS] * (gEducation == EDUC3)
			+ main_coefs[CVDPORT_MAIN_EDUC_PS_GRAD] * (gEducation == EDUC4)
			+ main_coefs[CVDPORT_MAIN_HYPERTENSION] * (gBP_PA == HIGH_BP_YES)
			+ main_coefs[CVDPORT_MAIN_DIABETES] * (gDiabetes_use == DIAB_YES); // added sum_k   coef_k  * Xk   so far

		hazard = hazard - mgCvdportAmiSumMainTermsCoefMeanCovariate[sex];   // substract sum_k   coef_k  * mean_Xk    so step 2 is done
																			//END   Step 2: add on sum_k   coef_k *  (Xk - mean_Xk)  =   ( sum_k   coef_k  * Xk -  sum_k   coef_k  * mean_Xk  ) over main terms (interactions and splines excluded)

																			//BEGIN Step 3: add on splines to complete the computation of CVDPoRT's score  
		hazard = hazard
			+ cvdport_ami_spline_age
			+ cvdport_ami_spline_bmi
			+ cvdport_ami_spline_pack_years
			+ cvdport_ami_spline_alcohol
			+ cvdport_ami_spline_met;

		hazard = hazard + CVDportAmiAlterationSpecs[sex][SPLIT(lifespan_age, FROM_25_TO_90_BY_5)];
		hazard = hazard + CVDportAmiAlterationSpecsBeforeSlope[sex][SPLIT(lifespan_age, FROM_25_TO_90_BY_5)] * (year - CVDportAmiTemporalBendingPoint) * (year < CVDportAmiTemporalBendingPoint);
		hazard = hazard + CVDportAmiAlterationSpecsAfterSlope[sex][SPLIT(lifespan_age, FROM_25_TO_90_BY_5)] * (year - CVDportAmiTemporalBendingPoint) * (year > CVDportAmiTemporalBendingPoint);
		//END   Step 3: add on splines to complete the computation of CVDPoRT's score  (at this point, local variable hazard contains CVDPoRT's score)

		hazard = exp(hazard); //  hazard = baseline * exp(score) with baseline handled below.

		if (CvdportAmiBaseline[sex] >= 0)
			hazard *= CvdportAmiBaseline[sex] / 5.0; //baseline = 5 year cumulative hazard / 5. 
		else
		{
			double log_cum_haz_age, log_cum_haz_agep1;

			log_cum_haz_age = PieceLinearLookup(lifespan_age, CvdportAmiLogBaseCumulativeHazard[sex][COORDINATES_X],
				CvdportAmiLogBaseCumulativeHazard[sex][COORDINATES_Y], SIZE(SCATTER_PLOT_ELEMENTS));
			log_cum_haz_agep1 = PieceLinearLookup(lifespan_age + 1, CvdportAmiLogBaseCumulativeHazard[sex][COORDINATES_X],
				CvdportAmiLogBaseCumulativeHazard[sex][COORDINATES_Y], SIZE(SCATTER_PLOT_ELEMENTS));

			hazard *= (exp(log_cum_haz_agep1) - exp(log_cum_haz_age)); //baseline hazard over [age,age+1] = H(age+1)-H(age)
		}

		if (acute_myocardial_infract == CVDPORT_AMI_NO)
			time_next = WAIT(-TIME(log(RandUniform(148)) / hazard));

		if (EcrireDebugLogEntry == 2 && WAIT(0) == time_person_created && CasesDebugLogEntry[LOWER_BOUND] <= case_id && case_id <= CasesDebugLogEntry[UPPER_BOUND])
		{
			char line[199];
			snprintf(line, 199, "%i, %i, %i, %i, %i, %i, %i, %0.9f \n", (int)case_id, (int)cchs_record, (int)sex, SPLIT(lifespan_age, FROM_20_TO_80_BY_5), (int)province, (int)acute_myocardial_infract_initial, (int)acute_myocardial_infract_initial_altered, (double)hazard);
			WriteDebugLogEntry(line);
		}


	}


	return time_next;
};

void hook_CvdportAmiDiseaseEvent() {};

void Person::CvdportAmiDiseaseEvent()
{
	acute_myocardial_infract = CVDPORT_AMI_YES;

	hook_CvdportAmiDiseaseEvent();
};



void PreSimulation()
{
	//BEGIN check alignment of CVDPORT_INTERACTION_TERMS and CVDPORT_MAIN_TERMS
	if (CVDPORT_INTER_AGE_SMOKER_CURRENT != CVDPORT_MAIN_SMOKER_CURRENT) ModelExit("CVDPORT_INTER_AGE_SMOKER_CURRENT      != CVDPORT_MAIN_SMOKER_CURRENT     .");
	if (CVDPORT_INTER_AGE_SMOKER_FORMER_LT5 != CVDPORT_MAIN_SMOKER_FORMER_LT5) ModelExit("CVDPORT_INTER_AGE_SMOKER_FORMER_LT5   != CVDPORT_MAIN_SMOKER_FORMER_LT5  .");
	if (CVDPORT_INTER_AGE_SMOKER_FORMER_GT5 != CVDPORT_MAIN_SMOKER_FORMER_GT5) ModelExit("CVDPORT_INTER_AGE_SMOKER_FORMER_GT5   != CVDPORT_MAIN_SMOKER_FORMER_GT5  .");
	if (CVDPORT_INTER_AGE_DRINK_FORMER != CVDPORT_MAIN_DRINK_FORMER) ModelExit("CVDPORT_INTER_AGE_DRINK_FORMER        != CVDPORT_MAIN_DRINK_FORMER       .");
	if (CVDPORT_INTER_AGE_HYPERTENSION != CVDPORT_MAIN_HYPERTENSION) ModelExit("CVDPORT_INTER_AGE_HYPERTENSION        != CVDPORT_MAIN_HYPERTENSION       .");
	if (CVDPORT_INTER_AGE_DIABETES != CVDPORT_MAIN_DIABETES) ModelExit("CVDPORT_INTER_AGE_DIABETES            != CVDPORT_MAIN_DIABETES           .");

	/*These are the fake interaction terms*/
	if (CVDPORT_INTER_AGE_EDUC_HIGH_SCHOOL_GRAD != CVDPORT_MAIN_EDUC_HIGH_SCHOOL_GRAD) ModelExit("CVDPORT_INTER_AGE_EDUC_HIGH_SCHOOL_GRAD        != CVDPORT_MAIN_EDUC_HIGH_SCHOOL_GRAD       .");
	if (CVDPORT_INTER_AGE_EDUC_SOME_PS != CVDPORT_MAIN_EDUC_SOME_PS) ModelExit("CVDPORT_INTER_AGE_EDUC_SOME_PS        != CVDPORT_MAIN_EDUC_SOME_PS       .");
	if (CVDPORT_INTER_AGE_EDUC_PS_GRAD != CVDPORT_MAIN_EDUC_PS_GRAD) ModelExit("CVDPORT_INTER_AGE_EDUC_PS_GRAD            != CVDPORT_MAIN_EDUC_PS_GRAD           .");

	

	//END   check alignment of CVDPORT_INTERACTION_TERMS and CVDPORT_MAIN_TERMS


	for (int sex_looper = 0; sex_looper<SIZE(SEX); sex_looper++)
	{
		//BEGIN get mgCvdportAmiSumMainTermsCoefMeanCovariate[sex_looper]
		mgCvdportAmiSumMainTermsCoefMeanCovariate[sex_looper] = 0;
		for (int x_looper = 0; x_looper<SIZE(CVDPORT_MAIN_TERMS); x_looper++)
			mgCvdportAmiSumMainTermsCoefMeanCovariate[sex_looper] += CvdportAmiMainTermsCoefficients[sex_looper][x_looper] * CvdportAmiMainTermsMeans[sex_looper][x_looper];
		//END   get mgCvdportAmiSumMainTermsCoefMeanCovariate[sex_looper]

		//BEGIN get mgCvdportAmiSumInteractionCoefMeanCovariate[sex_looper] 
		mgCvdportAmiSumInteractionCoefMeanCovariate[sex_looper] = 0;
		for (int x_looper = 0; x_looper<SIZE(CVDPORT_MAIN_TERMS); x_looper++)  // NOTA BONE alignment of CVDPORT_INTERACTION_TERMS and CVDPORT_MAIN_TERMS and used here
			mgCvdportAmiSumInteractionCoefMeanCovariate[sex_looper] += CvdportAmiInteractionCoefficients[sex_looper][x_looper] * CvdportAmiMainTermsMeans[sex_looper][x_looper];

		//Need to add on PackYears, DrinksLastWeek, MET, BMI not covered above
		mgCvdportAmiSumInteractionCoefMeanCovariate[sex_looper] += CvdportAmiInteractionCoefficients[sex_looper][CVDPORT_INTER_AGE_PACK_YEARS] * CvdportAmiPackYearsSplineCompanion[sex_looper][CUBIC_SPLINE_COMPANION_CENTER_LINEAR_TERM];
		mgCvdportAmiSumInteractionCoefMeanCovariate[sex_looper] += CvdportAmiInteractionCoefficients[sex_looper][CVDPORT_INTER_AGE_DRINKS_LAST_WEEK] * CvdportAmiDrinksSplineCompanion[sex_looper][CUBIC_SPLINE_COMPANION_CENTER_LINEAR_TERM];
		mgCvdportAmiSumInteractionCoefMeanCovariate[sex_looper] += CvdportAmiInteractionCoefficients[sex_looper][CVDPORT_INTER_AGE_PA_MET] * CvdportAmiMetsSplineCompanion[sex_looper][CUBIC_SPLINE_COMPANION_CENTER_LINEAR_TERM];
		mgCvdportAmiSumInteractionCoefMeanCovariate[sex_looper] += CvdportAmiInteractionCoefficients[sex_looper][CVDPORT_INTER_AGE_BMI] * CvdportAmiBmiSplineCompanion[sex_looper][CUBIC_SPLINE_COMPANION_CENTER_LINEAR_TERM];

		//END   get mgCvdportAmiSumInteractionCoefMeanCovariate[sex_looper]

	}


};