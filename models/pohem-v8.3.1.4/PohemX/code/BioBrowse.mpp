void PreSimulation()
{
	// WriteDebugLogEntry("case_id, population_source, year, age, sex, donor_id\n");
	// WriteDebugLogEntry("StartPop_id, sex, age\n");
	if (EcrireDebugLogEntry == 1)
		WriteDebugLogEntry("message,case_id,time\n");

//	if (EcrireDebugLogEntry == 2)
//		WriteDebugLogEntry("cchs_record,disease_init,disease_altered,risk\n");

	if (EcrireDebugLogEntry == 4)
		WriteDebugLogEntry("case_id,case_seed,time,dementia,sex,AgeC_rcs,PackYearsC_rcs,DrinksLastWeekC_rcs,PhysicalActivityC_rcs,BMIC_rcs,SmokeCurrentC_cat,SmokeFormer0to5C_cat,SmokeFormer5PlusC_cat,FormerDrinkerC_cat,EthnNWC_cat,EduHSGradC_cat,EduSomePSC_cat,EduPSGradC_cat,DiabetesC_cat,HypertensionC_cat,HeartDiseaseC_cat,StrokeC_cat,AgeC_rcs_Spline,PackYearsC_rcs_Spline,DrinksLastWeekC_rcs_Spline,PhysicalActivityC_rcs_Spline,BMIC_rcs_Spline,hazard\n");

	if (EcrireDebugLogEntry == 6)
		WriteDebugLogEntry("case_id,case_seed,time,sex,AgeC_rcs,PackYearsC_rcs,DrinksLastWeekC_rcs,PhysicalActivityC_rcs,BMIC_rcs,ResidencyC_rcs,SmokeCurrentC_cat,SmokeFormer0to5C_cat,SmokeFormer5PlusC_cat,FormerDrinkerC_cat,EthnNWC_cat,EduLTHSC_cat,EduHSGradC_cat,EduSomePSC_cat,DiabetesC_cat,HypertensionC_cat,HeartDiseaseC_cat,StrokeC_cat,CancerC_cat,DementiaC_cat,AgeC_rcs_Spline,PackYearsC_rcs_Spline,DrinksLastWeekC_rcs_Spline,PhysicalActivityC_rcs_Spline,BMIC_rcs_Spline,ResidencyC_rcs_Spline,hazard\n");

	if (EcrireDebugLogEntry == 8)
		WriteDebugLogEntry("case_id,case_seed,year,sex,AgeC_rcs,PackYearsC_rcs,DrinksLastWeekC_rcs,PhysicalActivityC_rcs,BMIC_rcs,ResidencyC_rcs,SmokeCurrentC_cat,SmokeFormer0to5C_cat,SmokeFormer5PlusC_cat,FormerDrinkerC_cat,EduLTHSC_cat,EduHSGradC_cat,EduSomePSC_cat,DiabetesC_cat,HypertensionC_cat,HeartDiseaseC_cat,StrokeC_cat,CancerC_cat,DementiaC_cat\n");

	if (EcrireDebugLogEntry == 93)
		WriteDebugLogEntry("case_id,case_seed,time,lifespan_age_start,truncated_age,timing_first_update,number_drinks_past_week_extra1,number_drinks_past_week_extra2,number_drinks_past_week_extra2_start,alcohol_quantile,alcohol_quantile_startpopg, gAlcohol5_no_intervention,gAlcohol5 \n");
	
	if (EcrireDebugLogEntry == 94)
		WriteDebugLogEntry( "case_id, case_seed, time, lifespan_age_start, truncated_age, gBike_errands_core, gWalk_errands_core, gPA_usual_day_core, gLTPA_cat_core \n" );
	
	if (EcrireDebugLogEntry == 95)
		WriteDebugLogEntry( "case_id, case_seed, time, lifespan_age_start, truncated_age, p_next_bike, p_next_walk, p_next_usual_day, p_next_LTPA_cat \n" );

	if (EcrireDebugLogEntry == 1234) {
		WriteDebugLogEntry("case_id, time, sex, lifespan_age_start, truncated_age, number_drinks_past_week_extra2_start, number_drinks_past_week_extra1, number_drinks_past_week_extra2, number_drinks_past_week, gAlcohol5_start,  gAlcohol5 \n");
	}
}	