range	DIGITS		{ 0, 9 };	//EN Digits
classification DIGIT_ORDER {//EN Digit order
	DIGIT_ORDER_1, //EN  First digit (10^4)
	DIGIT_ORDER_2, //EN Second digit (10^3)
	DIGIT_ORDER_3, //EN  Thrid digit (10^2)
	DIGIT_ORDER_4, //EN Fourth digit (10^1)
	DIGIT_ORDER_5  //EN  Fifth digit (10^0)
};

parameter_group ZZ_Debug_Parameters  //EN Debug Parameters
{
	EcrireDebugLogEntry,
	//CasesDebugLogEntry,
	FilterDigitTable,
	CasesDebugLogEntry
};


parameters {
	int	EcrireDebugLogEntry ; //EN EcrireDebugLogEntry
	int	CasesDebugLogEntry[cLOWER_UPPER_BOUNDS]; //EN CasesDebugLogEntry
	logical FilterDigitTable[DIGITS][DIGIT_ORDER]; //EN Filter for digit tables
};

hide(ZZ_Debug_Parameters);
// ----------------- BEGIN SEARCH INTERESTING CASES -----------------------
// ----------------- BEGIN SEARCH INTERESTING CASES -----------------------

/* BEGIN  Search for interesting cases  

// Do not forget to put this filter on tables -->  filter_digit_table 
// Do not forget to unhide 

actor Person            // Core Individual
{
	DIGITS case_id_digit1 = {9};
	DIGITS case_id_digit2 = {9};
	DIGITS case_id_digit3 = {9};
	DIGITS case_id_digit4 = {9};
	DIGITS case_id_digit5 = {9};
	logical filter_digit_table =    FilterDigitTable[case_id_digit1][DIGIT_ORDER_1] 
	                             && FilterDigitTable[case_id_digit2][DIGIT_ORDER_2]  
								 && FilterDigitTable[case_id_digit3][DIGIT_ORDER_3] 
								 && FilterDigitTable[case_id_digit4][DIGIT_ORDER_4] 
								 && FilterDigitTable[case_id_digit5][DIGIT_ORDER_5]  ;

	void InitializeDigits();
	hook InitializeDigits,Start, 190; // 190 = execution number, the higher the value, the later the execution;
};

void hook_InitializeDigits(){};

void Person::InitializeDigits()
{
	//MessageWhoWhenWhere(__FUNCTION__, 4==4);

	if(case_id<99999)
	{
		case_id_digit1 = case_id/10000;																				// 9 for case_id = 98765
		case_id_digit2 = (case_id-case_id_digit1*10000)/1000;														// 8 for case_id = 98765
		case_id_digit3 = (case_id-case_id_digit1*10000-1000*case_id_digit2)/100;									// 7 for case_id = 98765
		case_id_digit4 = (case_id-case_id_digit1*10000-1000*case_id_digit2-100*case_id_digit3)/10;					// 6 for case_id = 98765
		case_id_digit5 = (case_id-case_id_digit1*10000-1000*case_id_digit2-100*case_id_digit3-10*case_id_digit4)/1; // 5 for case_id = 98765
	}


	if (EcrireDebugLogEntry < 0 && CasesDebugLogEntry[LOWER_BOUND] <= case_id && case_id <= CasesDebugLogEntry[UPPER_BOUND] && filter_digit_table)
	{
		char line[199];
		snprintf(line, 199, "%i,%15.1f \n", (int)case_id, (double)case_seed);
		WriteDebugLogEntry(line);
		//std::stringstream ss;
		//ss << case_id << " , " << case_seed ;
		//WriteDebugLogEntry(ss.str().c_str());
	}

	hook_InitializeDigits();
}




table Person  tDB_SEP_d2   //EN Db prevalence by SEP 
  [ WITHIN(REPORT_YEAR, year) && filter_digit_table ]
{
	case_id_digit2+
	*
	{
	
	  nz_delta( duration( gDiabetes_use, DIAB_YES) ),	// Diabetes (prevalence)nz_delta( duration( gDiabetes_use, DIAB_YES)) from Claude
	  duration(), // total count of persons (duration)
	  nz_delta( duration( gDiabetes_use, DIAB_YES) )/duration() //EN Prevalence proportion
	}
	*	report_calendar_year 	// year
};

table Person  tDB_SEP_d3   //EN Db prevalence by SEP 
  [ WITHIN(REPORT_YEAR, year) && filter_digit_table ]
{
	case_id_digit3+
	*
	{
	
	  nz_delta( duration( gDiabetes_use, DIAB_YES) ),	// Diabetes (prevalence)nz_delta( duration( gDiabetes_use, DIAB_YES)) from Claude
	  duration(), // total count of persons (duration)
	  nz_delta( duration( gDiabetes_use, DIAB_YES) )/duration() //EN Prevalence proportion
	}
	*	report_calendar_year 	// year
};

table Person  tDB_SEP_d4   //EN Db prevalence by SEP 
  [ WITHIN(REPORT_YEAR, year) && filter_digit_table ]
{
	case_id_digit4+
	*
	{
	
	  nz_delta( duration( gDiabetes_use, DIAB_YES) ),	// Diabetes (prevalence)nz_delta( duration( gDiabetes_use, DIAB_YES)) from Claude
	  duration(), // total count of persons (duration)
	  nz_delta( duration( gDiabetes_use, DIAB_YES) )/duration() //EN Prevalence proportion
	}
	*	report_calendar_year 	// year
};

table Person  tDB_SEP_d5   //EN Db prevalence by SEP 
  [ WITHIN(REPORT_YEAR, year) && filter_digit_table ]
{
	case_id_digit5+
	*
	{
	
	  nz_delta( duration( gDiabetes_use, DIAB_YES) ),	// Diabetes (prevalence)nz_delta( duration( gDiabetes_use, DIAB_YES)) from Claude
	  duration(), // total count of persons (duration)
	  nz_delta( duration( gDiabetes_use, DIAB_YES) )/duration() //EN Prevalence proportion
	}
	*	report_calendar_year 	// year
};
  END  Search for interesting cases */

