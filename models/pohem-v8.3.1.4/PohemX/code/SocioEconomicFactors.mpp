#include "pohem.h"		

//FILE_LABEL (EN) Education and income quartile models
/* FILE_NOTE(EN) 
	This file updates the values (categories) of education and income at two year intervals. 
	  It implements regressions of individual education and income evolution observed in the longitudinal 
	  National Population Health Survey (1994-2006). 
	  BEGIN needs to be updated 
	    This module can be deactived by setting pEducation_model and pIncome_model to FALSE
	    
	  END needs to be updated 
*/
 



partition 	AGE_GROUP_from18_to25_by1	{ 18, 19, 20, 21, 22, 23, 24, 25}; //EN Age group
partition   AGE_GROUP_from25_to80_by5	{ 25, 30, 35, 40, 45, 50, 55, 60, 65, 70, 75, 80}; //EN Age group
range   RANGE_12_TO_80          {12  , 80};
range   RANGE_2001_TO_2009      {2001, 2009};


classification CCHS_CYCLE { //EN CCHS cycles
	CCHS_CYCLE_2001, //EN CCHS cycle 2001
	CCHS_CYCLE_2003, //EN CCHS cycle 2003
	CCHS_CYCLE_2005, //EN CCHS cycle 2005
	CCHS_CYCLE_2007, //EN CCHS cycle 2007
	CCHS_CYCLE_2009  //EN CCHS cycle 2009
};

classification AR_ORDER_INDEX_3 {  //EN Auto-regressive model 
    AR3_1,			//EN Auto-regressive model of order 1
	AR3_2,			//EN Auto-regressive model of order 2
	AR3_3			//EN Auto-regressive model of order 3
};

range BOOTSTRAP_INDEX_39 {0 , 39}; //EN Bootstrap id (0 is Full sample)

parameter_group pgIncome { //EN Income coefficients (NPHS)
INCOME_QUARTILE_Age_group_t,
INCOME_QUARTILE_Calendar_time,
INCOME_QUARTILE_Drink_cat_t,
INCOME_QUARTILE_Education_t,
INCOME_QUARTILE_Inc_qrt_Lt,
INCOME_QUARTILE_Inc_qrt_L2t,
INCOME_QUARTILE_Inc_qrt_L3t,
INCOME_QUARTILE_Intercept,
INCOME_QUARTILE_Malesex 
};

parameter_group pgEducation { //EN Education coefficients (NPHS)
EDUCATION_Age_cap25_t,
EDUCATION_Calendar_time,
EDUCATION_Education_Lt,
EDUCATION_Intercept,
EDUCATION_Malesex,
EDUCATION_Sp3_age_t_1,
EDUCATION_Sp3_age_t_2,
EDUCATION_Education_Lt_inter_Sp3_age_t_1,
EDUCATION_Education_Lt_inter_Sp3_age_t_2 ,
EducationDistributionByCCHSCycle
};
parameter_group pgSES_CONTROL { //EN Control parameters
	pgSES_EDUCATION_CONTROL,
	pgSES_INCOME_CONTROL
};

parameter_group pgSES_EDUCATION_CONTROL { //EN Education
  pEducation_model,	
  Educ_BootstrapIndexMultiplier,
  Educ_BootstrapOffset,	
  Educ_CalendarTimeCap ,
  AdjustInitialEducationAgeRange
};
parameter_group pgSES_INCOME_CONTROL { //EN Income
  pIncome_model,
  Income_MaxAutoRegressiveOrder,
  Income_BootstrapIndexMultiplier,
  Income_BootstrapOffset,
  Income_CalendarTimeCap
};

parameter_group pgSES_All { //EN Socio-economic model parameters
pgSES_CONTROL,
pgEducation,
pgIncome
};


parameters {
	
    /* NOTE ( Income_MaxAutoRegressiveOrder, EN )
     We have models of different auto-regressive order.
	   order 1: Income_Q(t) modeled from Income_Q(t-2) and other covariates
	   order 2: Income_Q(t) modeled from Income_Q(t-2),  Income_Q(t-4) and other covariates 
	   order 3: Income_Q(t) modeled from Income_Q(t-2),  Income_Q(t-4), Income_Q(t-6) and other covariates 
	   etc ...
	   The first Income_Q generated is from a model of auto-regressive order 1, the second Income_Q from order 2, etc...
	   At some point, we keep the same model as indicated by "Income_MaxAutoRegressiveOrder". Default value is 3.
    */
	AR_ORDER_INDEX_3 Income_MaxAutoRegressiveOrder;  //EN Auto-regressive model to be used as default for income model
    int	Income_BootstrapIndexMultiplier; //EN Allow the use of the bootstrap replicates (1) or not (0) for income model
	int	  Educ_BootstrapIndexMultiplier; //EN Allow the use of bootstrap replicates (1) or not (0) for education model
    int	Income_BootstrapOffset; //EN Bootstrap estimate to be used initially for income model
	int	  Educ_BootstrapOffset; //EN Bootstrap estimate to be used initially for education model

	logical pEducation_model; //EN Switch Education model on or off
	logical pIncome_model;    //EN Switch Income model on or off

	double	Income_CalendarTimeCap ; //EN Time cap on calendar trend applied to income model
	double	  Educ_CalendarTimeCap ; //EN Time cap on calendar trend applied to education model

	
double             EducationDistributionByCCHSCycle[SEX][CCHS_CYCLE        ][RANGE_12_TO_80][EDUCATION];
model_generated cumrate EducationDistributionByYear[SEX][RANGE_2001_TO_2009][RANGE_12_TO_80][EDUCATION];
double AdjustInitialEducationAgeRange[cLOWER_UPPER_BOUNDS];

double INCOME_QUARTILE_Intercept [BOOTSTRAP_INDEX_39][AR_ORDER_INDEX_3][INCOME_QUARTILE];								//EN Intercept
double INCOME_QUARTILE_Age_group_t [BOOTSTRAP_INDEX_39][AR_ORDER_INDEX_3][AGE_GROUP_from25_to80_by5 ][INCOME_QUARTILE]; //EN Age 
double INCOME_QUARTILE_Calendar_time [BOOTSTRAP_INDEX_39][AR_ORDER_INDEX_3][INCOME_QUARTILE];							//EN Calendar time 
double INCOME_QUARTILE_Drink_cat_t [BOOTSTRAP_INDEX_39][AR_ORDER_INDEX_3][ALCOHOL5 ][INCOME_QUARTILE];					//EN Alcohol
double INCOME_QUARTILE_Education_t [BOOTSTRAP_INDEX_39][AR_ORDER_INDEX_3][EDUCATION ][INCOME_QUARTILE];					//EN Education
double INCOME_QUARTILE_Inc_qrt_L2t [BOOTSTRAP_INDEX_39][AR_ORDER_INDEX_3][INCOME_QUARTILE ][INCOME_QUARTILE];			//EN Income (4 year lag)
double INCOME_QUARTILE_Inc_qrt_L3t [BOOTSTRAP_INDEX_39][AR_ORDER_INDEX_3][INCOME_QUARTILE ][INCOME_QUARTILE];			//EN Income (6 year lag)
//double INCOME_QUARTILE_Inc_qrt_L4t [BOOTSTRAP_INDEX_39][AR_ORDER_INDEX_3][INCOME_QUARTILE ][INCOME_QUARTILE];			//EN Income (8 year lag)
double INCOME_QUARTILE_Inc_qrt_Lt [BOOTSTRAP_INDEX_39][AR_ORDER_INDEX_3][INCOME_QUARTILE ][INCOME_QUARTILE];			//EN Income (2 year lag)
double INCOME_QUARTILE_Malesex [BOOTSTRAP_INDEX_39][AR_ORDER_INDEX_3][SEX ][INCOME_QUARTILE];							//EN Sex



double EDUCATION_Intercept [BOOTSTRAP_INDEX_39][EDUCATION];										//EN Intercept
double EDUCATION_Age_cap25_t [BOOTSTRAP_INDEX_39][AGE_GROUP_from18_to25_by1 ][EDUCATION];		//EN Age
double EDUCATION_Calendar_time [BOOTSTRAP_INDEX_39][EDUCATION];									//EN Calendar time 
double EDUCATION_Education_Lt [BOOTSTRAP_INDEX_39][EDUCATION ][EDUCATION];						//EN Education (2 year lag)
double EDUCATION_Sp3_age_t_1 [BOOTSTRAP_INDEX_39][EDUCATION];									//EN Linear spline at age 25
double EDUCATION_Sp3_age_t_2 [BOOTSTRAP_INDEX_39][EDUCATION];									//EN Linear spline at age 40
double EDUCATION_Malesex [BOOTSTRAP_INDEX_39][SEX ][EDUCATION];									//EN Sex
double EDUCATION_Education_Lt_inter_Sp3_age_t_1 [BOOTSTRAP_INDEX_39][EDUCATION ][EDUCATION];	//EN Interaction : education * (spline at age 25)
double EDUCATION_Education_Lt_inter_Sp3_age_t_2 [BOOTSTRAP_INDEX_39][EDUCATION ][EDUCATION];	//EN Interaction : education * (spline at age 40)

};


actor Person            // Core Individual
{
	EDUCATION_NA gEducation_na = EDUCATION_NA ( lifespan_age>19 ? gEducation : EDUC_NA_NA);
	logical  education_ever_changed = gEducation_startpop != gEducation;

	INCOME_QUARTILE    Histo_Income[AR_ORDER_INDEX_3];  //EN history of Income

	int     Income_BootstrapIndex={0}; 
	int       Educ_BootstrapIndex={0};

	logical due_for_biennial_update = (truncated_age>=lifespan_age_start+timing_first_update) && ((truncated_age-(lifespan_age_start+timing_first_update)) % 2) == 0 ;//EN Person due for update based on truncated_age    

	void UpdateIncome();    /*called annually */
	void UpdateEducation(); /*called annually */
    void InitializeEducation();  //Adjust a new person's education to account for temporal education trends  (never called for Philippe)

	hook UpdateEducation , RiskFactorsUpdatesEmptyHub, 10; // 10 = execution number, the higher the value, the later the execution  // UpdateEducation called annually
	hook UpdateIncome , RiskFactorsUpdatesEmptyHub, 20 ; // 20 = execution number, the higher the value, the later the execution  // UpdateIncome called annually

};

 /*A new person comes in the simulation during year 2022, say.
   We need the current education (and other initial characteristics) of this person.
   We use CCHS 1.1 for this, but some adjustment may be required because
   distribution of education of 18 years old in 2022 may differ from the corresponding distribution in 2001.
   This function actualize the education so that a more realistic education distribution will be achieved for
   people freshly created in the simulation (at time 2022, say).*/

void hook_InitializeEducation() {};

void Person::InitializeEducation()
{
	if ( calendar_year > 2001
		&& truncated_age >= (int) AdjustInitialEducationAgeRange[LOWER_BOUND]
		&& truncated_age <= (int) AdjustInitialEducationAgeRange[UPPER_BOUND] )
	{
		int nYear; //calendar year
		int nAge; //age
		int nEduc; //New education

		nAge =RANGE_POS(RANGE_12_TO_80,truncated_age);     //COERCE(RANGE_12_TO_80     , truncated_age)-MIN(RANGE_12_TO_80);
		nYear=RANGE_POS(RANGE_2001_TO_2009,calendar_year); //COERCE(RANGE_2001_TO_2009 , calendar_year)-MIN(RANGE_2001_TO_2009);

		/*  
		double A, B; //Underlying uniform quantile is between A and B
		double U; //Underlying uniform quantile

		A=0.0;
		for(int i=0; i<gEducation; i++)
			A += EducationDistributionByCCHSCycle[sex][CCHS_CYCLE_2001][nAge][i]/100.0;

		B = A +  EducationDistributionByCCHSCycle[sex][CCHS_CYCLE_2001][nAge][gEducation]/100.0;
		U=A+(B-A)*RandUniform( 91);

		Lookup_EducationDistributionByYear( U, sex, nYear, nAge  , &nEduc );
	   */
		Lookup_EducationDistributionByYear( RandUniform(92), sex, nYear, nAge  , &nEduc );
		gEducation=(EDUCATION)nEduc;
	}

	hook_InitializeEducation();
};

void hook_UpdateIncome() {};

void Person::UpdateIncome()  /*called annually */
{
	//MessageWhoWhenWhere(__FUNCTION__,TRUE);
	
	if ((truncated_age-lifespan_age_start) == timing_first_update) // things to do the first time around 
	{
	   // Initialize the history of the Income
       Histo_Income[0]=gIncomeQuartile;
       Histo_Income[1]=gIncomeQuartile;
       Histo_Income[2]=gIncomeQuartile;
       //  Histo_Income[3]=gIncomeQuartile;

       Income_BootstrapIndex =Income_BootstrapOffset + Income_BootstrapIndexMultiplier*(GetCaseSample() % (SIZE(BOOTSTRAP_INDEX_39)-Income_BootstrapOffset));
	}

	// Update income if user requested to use the dynamic income model 
	// and update every 2 years after a first scheduled update (smoothed updates)
	if ( pIncome_model	&&	 due_for_biennial_update  )
	{
		int		ar_order = {0};
		ar_order = (truncated_age-(lifespan_age_start+timing_first_update))/2;
	  //ar_order = min( ar_order, Income_MaxAutoRegressiveOrder-1 ); // BAD
		ar_order = min( ar_order, (int)Income_MaxAutoRegressiveOrder   ); // Keep in mind that AR3_1 = 0, AR3_2 = 1 and AR3_3 = 2
		ar_order = min( ar_order, SIZE( AR_ORDER_INDEX_3 )  - 1 );
		

	 //BEGIN Update Income based on its past values and the auto-regressive model

		double	p_next[SIZE(INCOME_QUARTILE)];
	
		for (int i=0; i<SIZE( INCOME_QUARTILE ); i++ )
		{

		   p_next[i]= 
			   INCOME_QUARTILE_Intercept    [Income_BootstrapIndex][ar_order][i] 
			 + INCOME_QUARTILE_Calendar_time[Income_BootstrapIndex][ar_order][i]* (min(time, Income_CalendarTimeCap) -1992.0) 
			 + INCOME_QUARTILE_Age_group_t  [Income_BootstrapIndex][ar_order][SPLIT(truncated_age,AGE_GROUP_from25_to80_by5) ][i] 
			 + INCOME_QUARTILE_Drink_cat_t  [Income_BootstrapIndex][ar_order][gAlcohol5][i] 
			 + INCOME_QUARTILE_Education_t  [Income_BootstrapIndex][ar_order][gEducation ][i] 
			 + INCOME_QUARTILE_Malesex      [Income_BootstrapIndex][ar_order][sex ][i] 
			 + INCOME_QUARTILE_Inc_qrt_Lt   [Income_BootstrapIndex][ar_order][Histo_Income[0] ][i] 
			 + INCOME_QUARTILE_Inc_qrt_L2t  [Income_BootstrapIndex][ar_order][Histo_Income[1] ][i] 
			 + INCOME_QUARTILE_Inc_qrt_L3t  [Income_BootstrapIndex][ar_order][Histo_Income[2] ][i] ;
			 // + INCOME_QUARTILE_Inc_qrt_L4t  [Income_BootstrapIndex][ar_order][Histo_Income[3] ][i] ;
		   p_next[i]= exp(p_next[i]);
		}
	 gIncomeQuartile=(INCOME_QUARTILE) pps_sampling(RandUniform( 77), p_next, SIZE(INCOME_QUARTILE));



	  //END Update Income based on its past values and the auto-regressive model

	 // Update history
		for (int i=SIZE( AR_ORDER_INDEX_3 )-1; i>0; i-- )
			Histo_Income[i]=Histo_Income[i-1];
		Histo_Income[0]=gIncomeQuartile;
	}

	hook_UpdateIncome();
}	

void hook_UpdateEducation() {};

void Person::UpdateEducation()  /*called annually */
{
	//MessageWhoWhenWhere(__FUNCTION__, 4==4);
	if ((truncated_age-lifespan_age_start) == timing_first_update) // things to do the first time around 
	{  
       Educ_BootstrapIndex =Educ_BootstrapOffset + Educ_BootstrapIndexMultiplier*(GetCaseSample() % (SIZE(BOOTSTRAP_INDEX_39)-Educ_BootstrapOffset));	
	}
		
	// Update education if user requested to use the dynamic education model 
	// and update every 2 years after a first scheduled update (smoothed updates)
	if ( pEducation_model  &&  due_for_biennial_update   && ( truncated_age>=17 && truncated_age<=69 ) )
	{
		//BEGIN Update Education based on its past values and the auto-regressive model

		double	p_next[SIZE(EDUCATION)];
	
		for (int i=0; i<SIZE(EDUCATION); i++ )
		{
		   p_next[i]= 
			   EDUCATION_Intercept    [Educ_BootstrapIndex][i] 
			 + EDUCATION_Calendar_time[Educ_BootstrapIndex][i]* (min(time, Educ_CalendarTimeCap) -1992.0) 
			 + EDUCATION_Age_cap25_t  [Educ_BootstrapIndex][SPLIT(truncated_age,AGE_GROUP_from18_to25_by1) ][i] 
			 + EDUCATION_Sp3_age_t_1  [Educ_BootstrapIndex][i]* (max(truncated_age,25.0) -25.0)
			 + EDUCATION_Sp3_age_t_2  [Educ_BootstrapIndex][i]* (max(truncated_age,40.0) -40.0)
			 + EDUCATION_Education_Lt [Educ_BootstrapIndex][gEducation ][i] 
			 + EDUCATION_Education_Lt_inter_Sp3_age_t_1 [Educ_BootstrapIndex][gEducation ][i] * (max(truncated_age,25.0) -25.0)
			 + EDUCATION_Education_Lt_inter_Sp3_age_t_2 [Educ_BootstrapIndex][gEducation ][i] * (max(truncated_age,40.0) -40.0)
			 + EDUCATION_Malesex      [Educ_BootstrapIndex][sex ][i] ;

		   p_next[i]= exp(p_next[i]);
		}
		gEducation=(EDUCATION) pps_sampling(RandUniform(78 ), p_next, SIZE(EDUCATION));


	  //END Update Education based on its past values and the auto-regressive model
	}

	hook_UpdateEducation();
}	

void PreSimulation()
{
	for(int nSex = 0; nSex < SIZE(SEX); nSex++)
		for(int nEduc = 0; nEduc < SIZE(EDUCATION); nEduc++)
			for(int nAge = 0; nAge <SIZE(RANGE_12_TO_80); nAge++)
				for(int cycle = 0; cycle < SIZE(CCHS_CYCLE); cycle++)
			    {
				    EducationDistributionByYear     [nSex][RANGE_POS(RANGE_2001_TO_2009,2001+2*cycle)][nAge][nEduc]=
				    EducationDistributionByCCHSCycle[nSex][cycle                                     ][nAge][nEduc];

				  if(cycle)
				  {
				    EducationDistributionByYear     [nSex][RANGE_POS(RANGE_2001_TO_2009,2001+2*cycle-1)][nAge][nEduc]=(
				    EducationDistributionByCCHSCycle[nSex][cycle                                       ][nAge][nEduc]+
				    EducationDistributionByCCHSCycle[nSex][cycle -1                                    ][nAge][nEduc]   )/2.0;
				  }					   
			    }

}
