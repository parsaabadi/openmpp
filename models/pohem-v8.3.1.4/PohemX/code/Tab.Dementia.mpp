	table Person tDementia_Mortality											//EN Mortality by age, sex, year and dementia status
		[in_tabulation_scope && report_calendar_year == calendar_year && calendar_year < MaxYear]
	{
		{
			entrances(alive, FALSE),											//EN Death counts
			entrances(alive, FALSE) / duration(),								//EN Death hazard rate  decimals=5
			nz_delta(duration()),												//EN Population counts
			duration()															//EN Person-years		decimals=1
		}
		*split(lifespan_age, AGE_GROUP_20_TO_90_BY_5) +							//EN Age group
		*sex +																	//EN Sex
		*report_calendar_year													//EN Year
		* dementia +															//EN Dementia status
	};