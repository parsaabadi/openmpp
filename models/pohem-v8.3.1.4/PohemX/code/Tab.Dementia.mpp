			 event(punctual_dementia_costs_hospital_admissions) + weighted_duration(dementia_hospital_admissions_progression) ,				//EN Dementia costs: hospital admissions
			 event(punctual_dementia_costs_homecare) + weighted_duration(dementia_homecare_progression)            ,				//EN Dementia costs: homecare
			 event(punctual_dementia_costs_longtermcare) + weighted_duration(dementia_longtermcare_progression)        ,				//EN Dementia costs: long-term care
			 event(punctual_dementia_costs_assistive_devices) + weighted_duration(dementia_assistive_devices_progression)					//EN Dementia costs: assistive devices
		}
		*split(lifespan_age,AGE_GROUP_20_TO_90_BY_5) +						//EN Age group
		*split(gBMI4_dementia, BMI4CAT) +									//EN BMI status
		*tabulate_dementia_cost_in_this_time_cat +							//EN Dementia time category
		*report_calendar_year +												//EN Year
	};

