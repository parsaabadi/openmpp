/* NOTE ( RR_SAMPLES )
The number of different sets of relative risk estimates that will be used to span
the space of all possible risk factor combinations bases on their individual 
distributions.  This is used under the "Monte" and "LatinHyperCube" methods of 
selecting the relative risks.  Initially, we will continue to employ the subsample
method of assignment (which is limited to a maximum of 40) but at some time may
wish to switch to a cloning assignment.
>
Formerly known as MAX_SUBSAMPLES.  When using past scenarios with this version 
of POHEM.EXE the dat files will need to be changed to use RR_SAMPLES.
*/

#include "pohem.h"
#include "StatDistributionsFromDcdflib.H"
#include "StatDistributionsFromR.H"

range RR_SAMPLES {0,39};

classification STATISTICAL_PACKAGE {
	STATISTICAL_PACKAGE_DUMMY,  //EN Dummy
	STATISTICAL_PACKAGE_R_OPEN_SOURCE, //EN R open source code
	STATISTICAL_PACKAGE_DCDFLIB //EN DCDFLIB
};
