	LOWER_BOUND,					// Lower bound
	UPPER_BOUND						// Upper bound
};

range SCATTER_PLOT_ELEMENTS{	//EN Data point index
	0, 9
};
classification COORDINATES_X_Y{  //EN Size or probability
	COORDINATES_X, //EN X  (e.g. age)
	COORDINATES_Y  //EN Y (e.g. log cumulative hazard)
};

range CUBIC_SPLINE_KNOTS_INDEX  {1, 20}; //EN List of knots
classification CUBIC_SPLINE_KNOTS_LOCATION_COEFFICIENT{ //EN Cubic spline knots location and coefficient

	CUBIC_SPLINE_KNOTS_LOCATION,    //EN Knot location
	CUBIC_SPLINE_KNOTS_COEFFICIENT  //EN Knot coefficient
};
