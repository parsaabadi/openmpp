	UNIFORM_SILOS_BOTTOM,  //EN Corridor of small uniform variates
	UNIFORM_SILOS_MIDDLE,  //EN Corridor of intermediate uniform variates 
	UNIFORM_SILOS_TOP      //EN Corridor of uniform variates corridor
};

