	ARMAPLUS_11_A_t,   //EN a_t
//Plus part
	ARMAPLUS_11_KAPPA, //EN kappa
	ARMAPLUS_11_X,     //EN X ~ N(0,1) static
//Final product ARMAplus(1,1) process
	ARMAPLUS_11_Y_t    //EN Y_t
};

