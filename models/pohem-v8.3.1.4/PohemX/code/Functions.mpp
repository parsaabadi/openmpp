		CUBIC_SPLINE_COMPANION_MIN, //EN Lower bound for entity used to compute spline
		CUBIC_SPLINE_COMPANION_MAX, //EN Upper bound for entity used to compute spline
		CUBIC_SPLINE_COMPANION_RANGE_POWER, //EN Power of knot range for scaling
		CUBIC_SPLINE_COMPANION_CENTER_LINEAR_TERM, //EN Center linear term 
		CUBIC_SPLINE_COMPANION_LINEAR_COEFFICIENT, //EN Coefficient for linear term
		CUBIC_SPLINE_COMPANION_CENTER_CUBIC_TERM   //EN Center cubic spline term 
};

classification ARMAPLUS_11_PARAMETERS{  //EN ARMAplus(1,1) parameters
	ARMAPLUS_11_PARAM_PHI,   //EN phi
	ARMAPLUS_11_PARAM_THETA, //EN theta
	ARMAPLUS_11_PARAM_KAPPA  //EN kappa
};

