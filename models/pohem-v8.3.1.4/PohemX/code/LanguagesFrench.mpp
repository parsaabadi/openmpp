//LABEL(COPD_STAGE0, FR) Le stade 0 signifie l'absence de BPCO,
//LABEL(COPD_STAGE1, FR) BPCO légère, GOLD 1
//LABEL(COPD_STAGE2, FR) BPCO modérée, GOLD 2
//LABEL(COPD_STAGE3, FR) BPCO sévère, GOLD 3
//LABEL(COPD_STAGE4, FR) BPCO très sévère, GOLD 4
