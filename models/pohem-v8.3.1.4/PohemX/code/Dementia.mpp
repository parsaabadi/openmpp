#include "pohem.h"
//FILE_LABEL (EN) Dementia
/* FILE_NOTE(EN)

This file implements dementia incidence calculation using the DemPORT algorithm.
*/

// Customized "include"
// Structure of MPP Files
// classifications, ranges, partitions
// Parameters
// Person state variable declarations
// (functions)
// Person Events
// Presimulation code

// Dementia

classification DEMPORT_MAIN_TERMS{	//EN DEMPORT risk algorithm main terms (non-cubic spline)


	DEMPORT_MAIN_SMOKER_CURRENT,           //EN Current smoker
	DEMPORT_MAIN_SMOKER_FORMER_LT5,        //EN Former smoker quit less than 5 years ago
	DEMPORT_MAIN_SMOKER_FORMER_GT5,        //EN Former smoker quit 5 years ago or more
	DEMPORT_MAIN_DRINK_FORMER,             //EN Former drinker
	DEMPORT_MAIN_HEART_DISEASE,			   //EN Has heart disease
	DEMPORT_MAIN_STROKE,					//EN Has stroke
	DEMPORT_MAIN_DIABETES,					//EN Has diabetes
	DEMPORT_MAIN_HYPERTENSION,             //EN Has hypertension/ high blood pressure


											/*DEMPORT_MAIN_IMMIGRANT,				   //EN Immigrant status*/
	DEMPORT_MAIN_EDUC_HIGH_SCHOOL_GRAD,    //EN High school grad
	DEMPORT_MAIN_EDUC_SOME_PS,             //EN Some post-secondary education
	DEMPORT_MAIN_EDUC_PS_GRAD,              //EN Post-secondary grad

										   /*DEMPORT_MAIN_MARITAL_STATUS,		//EN Marital status- This final version of POHEM-Dementia will include marital status. This is commented out for now-DH*/
										   /*DEMPORT_MAIN_COPD,					//EN Has COPD- COPD will be added to POHEM in the near future, but it is comment outed for now-DH*/

										   /*DEMPORT_MAIN_EPILEPSY,				//EN Has epilepsy- All the following terms are included in the original DEMPoRT model,  but not in POHEM. They are included here for completeness-DH*/
	DEMPORT_MAIN_ETHNICITY					//EN White, non-white ethnicity*/
										   /*DEMPORT_MAIN_MOOD_DISORDER,		//EN Has mood disorder*/
										   /*DEMPORT_MAIN_NEIGHBOURHOOD_DEP,	//EN Neighbourhood deprivation*/
										   /*DEMPORT_MAIN_MULTILING,			//EN Multilingual status*/
										   /*DEMPORT_MAIN_SENSE_BELONG,			//EN Sense of belonging*/
										   /*DEMPORT_MAIN_STRESS,				//EN Stress*/
										   /*DEMPORT_MAIN_SRH					//EN Self-rated health*/
};

classification DEMPORT_INTERACTION_TERMS{	//EN DEMPORT risk algorithm interaction coefficients 


	DEMPORT_INTER_AGE_SMOKER_CURRENT,       //EN Interaction Age * current smoker
	DEMPORT_INTER_AGE_SMOKER_FORMER_LT5,    //EN Interaction Age * former smoker quit less than 5 years ago
	DEMPORT_INTER_AGE_SMOKER_FORMER_GT5,    //EN Interaction Age * former smoker quit 5 years ago or more
	DEMPORT_INTER_AGE_DRINK_FORMER,         //EN Interaction Age * former drinker
	DEMPORT_INTER_AGE_HEART_DISEASE,		//EN Interaction Age * heart disease
	DEMPORT_INTER_AGE_STROKE,				//EN Interaction Age * stroke
	DEMPORT_INTER_AGE_DIABETES,             //EN Interaction Age * diabetes
	DEMPORT_INTER_AGE_HYPERTENSION,         //EN Interaction Age * hypertension

	/*November 20th 2019- These interaction terms were introduced to ensure the presim section of the code worked properly- DH- Gitlab issue #25 for more details*/

	/*DEMPORT_INTER_AGE_IMMIGRANT,				//EN Immigrant status*/
	
	DEMPORT_INTER_AGE_EDUC_HIGH_SCHOOL_GRAD,    //EN High school grad
	DEMPORT_INTER_AGE_EDUC_SOME_PS,             //EN Some post-secondary education
	DEMPORT_INTER_AGE_EDUC_PS_GRAD,              //EN Post-secondary grad
	DEMPORT_INTER_AGE_ETHNICITY,				//EN Ethnicity


  /*DEMPORT_INTER_AGE_MOOD_DISORDER,        //EN Interaction Age * mood disorder*/
  /*DEMPORT_INTER_AGE_COPD,                 //EN Interaction Age * COPD*/
  /*DEMPORT_INTER_AGE_EPILEPSY,             //EN Interaction Age * epilepsy*/

	DEMPORT_INTER_AGE_PACK_YEARS,           //EN Interaction Age * pack years
	DEMPORT_INTER_AGE_DRINKS_LAST_WEEK,     //EN Interaction Age * drinks last week
	DEMPORT_INTER_AGE_PA_MET,               //EN Interaction Age * physical activity MET
	DEMPORT_INTER_AGE_BMI					//EN Interaction Age * BMI


};

classification DEMPORT_STATE{	//EN Dementia state
	DEMENTIA_NO,						 //EN No Dementia
	DEMENTIA_YES						 //EN Dementia

};

classification DEMENTIA_TIME_CAT{	//EN Dementia time categories
	YEAR_BEFORE_DIAGNOSIS,				//EN Year prior to diagnosis
	DIAGNOSIS_YEAR,  					//EN Diagnosis year
	PROGRESSION,						//EN Progression
	END_OF_LIFE							//EN End-of-life
};

parameter_group pgDEMENTIA{		//EN Dementia modelled with DEMPORT
	DementiaMinimumAgeForIncidence,
	DementiaBaseline,
	DementiaLogBaseCumulativeHazard,
	DementiaMainTermsMeans,
	DementiaMainTermsCoefficients,
	DementiaInteractionCoefficients,
	DementiaAgeSplineLocationCoef,
	DementiaAgeSplineCompanion,
	DementiaPackYearsSplineLocationCoef,
	DementiaPackYearsSplineCompanion,
	DementiaDrinksSplineLocationCoef,
	DementiaDrinksSplineCompanion,
	DementiaMetsSplineLocationCoef,
	DementiaMetsSplineCompanion,
	DementiaBmiSplineLocationCoef,
	DementiaBmiSplineCompanion,
	/*DementiaFruitVegSplineLocationCoef, // EN Commented out terms are included in the original DEMPoRT model,  but not in POHEM. They are included here for completeness-DH
	DementiaFruitVegSplineCompanion,
	DementiaPotatoSplineLocationCoef,
	DementiaPotatoSplineCompanion,
	DementiaJuiceSplineLocationCoef,
	DementiaJuiceSplineCompanion,*/
	DementiaAlterationSpecs,
	DementiaAlterationSpecsBeforeSlope,
	DementiaAlterationSpecsAfterSlope,
	DementiaTemporalBendingPoint,
	DementiaAlterationSpecsAppliesToPrevalenceFixSR
	/*pgDEMENTIA_Calibration_Inputs*/

};

parameter_group pgDEMENTIA_COSTS{		//EN Dementia costs
	DementiaPhysicianCosts,
	DementiaPrescriptionDrugs,
	DementiaHospitalAdmissions,
	DementiaHomeCare,
	DementiaLongTermCare,
	DementiaAssistiveDevices
};

parameters{
int     DementiaMinimumAgeForIncidence; //EN DEMPORT minimum incidence age

double  DementiaLogBaseCumulativeHazard[SEX][COORDINATES_X_Y][SCATTER_PLOT_ELEMENTS];//EN DEMPORT log baseline cumulative hazard	
double  DementiaBaseline[SEX]; //EN DEMPORT 5 year baseline cumulative hazard
double	DementiaMainTermsMeans[SEX][DEMPORT_MAIN_TERMS]; //EN DEMPORT main non-spline terms means 
double	DementiaMainTermsCoefficients[SEX][DEMPORT_MAIN_TERMS]; //EN DEMPORT main non-spline terms coefficients
double	DementiaInteractionCoefficients[SEX][DEMPORT_INTERACTION_TERMS]; //EN DEMPORT interaction terms

double  DementiaAgeSplineLocationCoef[SEX][CUBIC_SPLINE_KNOTS_LOCATION_COEFFICIENT][CUBIC_SPLINE_KNOTS_INDEX];  //EN DEMPORT age cubic spline coefficients 
double  DementiaAgeSplineCompanion[SEX][CUBIC_SPLINE_COMPANION];                                             //EN DEMPORT age cubic spline companion 

double  DementiaPackYearsSplineLocationCoef[SEX][CUBIC_SPLINE_KNOTS_LOCATION_COEFFICIENT][CUBIC_SPLINE_KNOTS_INDEX];  //EN DEMPORT pack years cubic spline coefficients 
double  DementiaPackYearsSplineCompanion[SEX][CUBIC_SPLINE_COMPANION];                                             //EN DEMPORT pack years cubic spline companion 

double  DementiaDrinksSplineLocationCoef[SEX][CUBIC_SPLINE_KNOTS_LOCATION_COEFFICIENT][CUBIC_SPLINE_KNOTS_INDEX];  //EN DEMPORT drinks last week cubic spline coefficients 
double  DementiaDrinksSplineCompanion[SEX][CUBIC_SPLINE_COMPANION];                                             //EN DEMPORT drinks last week cubic spline companion 

double  DementiaMetsSplineLocationCoef[SEX][CUBIC_SPLINE_KNOTS_LOCATION_COEFFICIENT][CUBIC_SPLINE_KNOTS_INDEX];  //EN DEMPORT METs cubic spline coefficients 
double  DementiaMetsSplineCompanion[SEX][CUBIC_SPLINE_COMPANION];                                             //EN DEMPORT METs cubic spline companion 

double  DementiaBmiSplineLocationCoef[SEX][CUBIC_SPLINE_KNOTS_LOCATION_COEFFICIENT][CUBIC_SPLINE_KNOTS_INDEX];  //EN DEMPORT BMI cubic spline coefficients 
double  DementiaBmiSplineCompanion[SEX][CUBIC_SPLINE_COMPANION];                                             //EN DEMPORT BMI cubic spline companion 

double  DementiaAlterationSpecs[SEX][FROM_25_TO_90_BY_5];    //EN Alteration of DEMPORT log hazard by sex and age
logical DementiaAlterationSpecsAppliesToPrevalenceFixSR;    //EN Use altered DEMPORT log hazard in correction for initial dementia prevalence

int  DementiaTemporalBendingPoint; //EN Label for DementiaTemporalBendingPoint

double  DementiaAlterationSpecsBeforeSlope[SEX][FROM_25_TO_90_BY_5];    //EN Label for DementiaAlterationSpecsBeforeSlope
double  DementiaAlterationSpecsAfterSlope[SEX][FROM_25_TO_90_BY_5];    //EN Label for DementiaAlterationSpecsAfterSlope

model_generated double mgDementiaSumMainTermsCoefMeanCovariate[SEX];
model_generated double mgDementiaSumInteractionCoefMeanCovariate[SEX];

double  DementiaPhysicianCosts[SEX][FROM_25_TO_90_BY_5][DEMPORT_STATE][DEMENTIA_TIME_CAT];			//EN Physician costs
double  DementiaPrescriptionDrugs[SEX][FROM_25_TO_90_BY_5][DEMPORT_STATE][DEMENTIA_TIME_CAT];		//EN Prescription drugs
double  DementiaHospitalAdmissions[SEX][FROM_25_TO_90_BY_5][DEMPORT_STATE][DEMENTIA_TIME_CAT];		//EN Hospital Admissions
double  DementiaHomeCare[SEX][FROM_25_TO_90_BY_5][DEMPORT_STATE][DEMENTIA_TIME_CAT];				//EN Home care
double  DementiaLongTermCare[SEX][FROM_25_TO_90_BY_5][DEMPORT_STATE][DEMENTIA_TIME_CAT];			//EN Long-term care
double  DementiaAssistiveDevices[SEX][FROM_25_TO_90_BY_5][DEMPORT_STATE][DEMENTIA_TIME_CAT];		//EN Assistive devices
};

actor Person            // Core Individual
{
double gBMI4_dementia = gBMI_PHAC ;

double dementia_spline_age = UpdateDementiaSplineAge(lifespan_age, sex, dementia);
double dementia_spline_bmi = UpdateDementiaSplineBmi(gBMI4_dementia, sex, dementia);
double dementia_spline_pack_years = UpdateDementiaSplinePackYears(total_packyears_smoked, sex, dementia);
double dementia_spline_alcohol = UpdateDementiaSplineAlcohol(number_drinks_past_week, sex, dementia); // icitte will need to make number_drinks_past_week dynamic
double dementia_spline_met = UpdateDementiaSplineMet(physical_activity_met, sex, dementia);

DEMPORT_STATE dementia; //EN Dementia (DEMPoRT)
DEMPORT_STATE dementia_initial; //EN Dementia at start
DEMPORT_STATE dementia_initial_altered; //EN Dementia status altered at start (static afterwards)
TIME          dementia_time_begin; //EN Time first has dementia in POHEM
double		  age_at_dementia_onset; //EN Integer age at dementia onset

DEMENTIA_TIME_CAT tabulate_dementia_cost_in_this_time_cat = { PROGRESSION };  //EN Dementia time categories
logical  it_is_time_to_tabulate_end_of_life_cost = { FALSE };

/* BEGIN 6 states that will be updated to account for the following punctual (i.e. applied at given moment) costs: year_before_diagnosis, diagnosis, end_of_life*/
double punctual_dementia_costs_physician           = { 0 }; //EN Dementia costs: physician
double punctual_dementia_costs_prescription        = { 0 }; //EN Dementia costs: prescription
double punctual_dementia_costs_hospital_admissions = { 0 }; //EN Dementia costs: hospital admissions
double punctual_dementia_costs_homecare            = { 0 }; //EN Dementia costs: homecare
double punctual_dementia_costs_longtermcare        = { 0 }; //EN Dementia costs: longtermcare
double punctual_dementia_costs_assistive_devices   = { 0 }; //EN Dementia costs: assistive devices
/* END 6 states that will be updated to account for the following punctual (i.e. applied at given moment) costs: year_before_diagnosis, diagnosis, end_of_life*/

double dementia_physician_progression           = DementiaPhysicianCosts[sex][split(lifespan_age,FROM_25_TO_90_BY_5)][dementia][PROGRESSION];
double dementia_prescription_progression        = DementiaPrescriptionDrugs[sex][split(lifespan_age,FROM_25_TO_90_BY_5)][dementia][PROGRESSION];
double dementia_hospital_admissions_progression = DementiaHospitalAdmissions[sex][split(lifespan_age,FROM_25_TO_90_BY_5)][dementia][PROGRESSION];
double dementia_homecare_progression            = DementiaHomeCare[sex][split(lifespan_age,FROM_25_TO_90_BY_5)][dementia][PROGRESSION];
double dementia_longtermcare_progression        = DementiaLongTermCare[sex][split(lifespan_age,FROM_25_TO_90_BY_5)][dementia][PROGRESSION];
double dementia_assistive_devices_progression   = DementiaAssistiveDevices[sex][split(lifespan_age,FROM_25_TO_90_BY_5)][dementia][PROGRESSION];

double dementia_physician_diagnosis = {0};
double dementia_prescription_diagnosis = {0};
double dementia_hospital_admissions_diagnosis = {0};
double dementia_homecare_diagnosis = {0};
double dementia_longtermcare_diagnosis = {0};
double dementia_assistive_devices_diagnosis = {0};

double dementia_physician_year_before_diagnosis = {0};
double dementia_prescription_year_before_diagnosis = {0};
double dementia_hospital_admissions_year_before_diagnosis = {0};
double dementia_homecare_year_before_diagnosis = {0};
double dementia_longtermcare_year_before_diagnosis = {0};
double dementia_assistive_devices_year_before_diagnosis = {0};

double dementia_physician_end_of_life = {0};
double dementia_prescription_end_of_life = {0};
double dementia_hospital_admissions_end_of_life = {0};
double dementia_homecare_end_of_life = {0};
double dementia_longtermcare_end_of_life = {0};
double dementia_assistive_devices_end_of_life = {0};

event   timeDementiaDiseaseEvent, DementiaDiseaseEvent; // , 0;  //  default low priority    

void	ReadFromStartPopDEM();
hook    ReadFromStartPopDEM, ReadFromStartPop, 110; // 110 = execution number, the higher the value, the later the execution
};

void hook_ReadFromStartPopDEM() {};

void Person::ReadFromStartPopDEM()
{
	//MessageWhoWhenWhere(__FUNCTION__, 4 == 4);
	const double *record_to_be_read;
	record_to_be_read = FictivePersonCharacteristics[ROW_1][cDb_Weight] < 0.0 ? pStartPop[cchs_record] : FictivePersonCharacteristics[ROW_1];

	dementia = (DEMPORT_STATE) int(record_to_be_read[cDb_Dementia]);
	dementia_initial = (DEMPORT_STATE) int(record_to_be_read[cDb_Dementia]);
	dementia_initial_altered = (DEMPORT_STATE) int(record_to_be_read[cDb_Dementia]); 

	hook_ReadFromStartPopDEM();
};

// This code udpates the splines

double UpdateDementiaSplineAge(int    x, SEX sexe, DEMPORT_STATE dementia)
{
	return  dementia == DEMENTIA_YES ? 0.0 :
		CubicSpline((double)x, (double*)DementiaAgeSplineLocationCoef[sexe][CUBIC_SPLINE_KNOTS_LOCATION],
			(double*)DementiaAgeSplineLocationCoef[sexe][CUBIC_SPLINE_KNOTS_COEFFICIENT],
			(double*)DementiaAgeSplineCompanion[sexe]);
};

double UpdateDementiaSplineBmi(double x, SEX sexe, DEMPORT_STATE dementia)
{
	return  dementia == DEMENTIA_YES ? 0.0 :
		CubicSpline((double)x, (double*)DementiaBmiSplineLocationCoef[sexe][CUBIC_SPLINE_KNOTS_LOCATION],
			(double*)DementiaBmiSplineLocationCoef[sexe][CUBIC_SPLINE_KNOTS_COEFFICIENT],
			(double*)DementiaBmiSplineCompanion[sexe]);
};

double UpdateDementiaSplinePackYears(double x, SEX sexe, DEMPORT_STATE dementia)
{
	return  dementia == DEMENTIA_YES ? 0.0 :
		CubicSpline((double)x, (double*)DementiaPackYearsSplineLocationCoef[sexe][CUBIC_SPLINE_KNOTS_LOCATION],
			(double*)DementiaPackYearsSplineLocationCoef[sexe][CUBIC_SPLINE_KNOTS_COEFFICIENT],
			(double*)DementiaPackYearsSplineCompanion[sexe]);
};

double UpdateDementiaSplineAlcohol(int    x, SEX sexe, DEMPORT_STATE dementia)
{
	return  dementia == DEMENTIA_YES ? 0.0 :
		CubicSpline((double)x, (double*)DementiaDrinksSplineLocationCoef[sexe][CUBIC_SPLINE_KNOTS_LOCATION],
			(double*)DementiaDrinksSplineLocationCoef[sexe][CUBIC_SPLINE_KNOTS_COEFFICIENT],
			(double*)DementiaDrinksSplineCompanion[sexe]);
};

double UpdateDementiaSplineMet(double x, SEX sexe, DEMPORT_STATE dementia)
{
	return  dementia == DEMENTIA_YES ? 0.0 :
		CubicSpline((double)x, (double*)DementiaMetsSplineLocationCoef[sexe][CUBIC_SPLINE_KNOTS_LOCATION],
			(double*)DementiaMetsSplineLocationCoef[sexe][CUBIC_SPLINE_KNOTS_COEFFICIENT],
			(double*)DementiaMetsSplineCompanion[sexe]);
};

TIME Person::timeDementiaDiseaseEvent()
{
	TIME time_next = TIME_INFINITE;

	if (lifespan_age < DementiaMinimumAgeForIncidence)
		return time_next;

	if (tabulate_dementia_cost_in_this_time_cat == YEAR_BEFORE_DIAGNOSIS || tabulate_dementia_cost_in_this_time_cat == DIAGNOSIS_YEAR)
		return WAIT(0);  // Currently doing the fancy cost tabulation.  Re-schedule even now so that tabulate_dementia_cost_in_this_time_cat can be reset to proper value (and cost tabulated if applicable)

	if (dementia== DEMENTIA_NO)
	{

		const double *main_coefs = DementiaMainTermsCoefficients[sex];
		const double *interactions = DementiaInteractionCoefficients[sex];

		double hazard;
		//BEGIN Step 1: sum_k   coef_k * (age - mean_age ) * (Xk - mean_Xk)  =  (age - mean_age ) * ( sum_k   coef_k  * Xk -  sum_k   coef_k  * mean_Xk  )
		hazard = interactions[DEMPORT_INTER_AGE_SMOKER_CURRENT] * (smoking_status4 == LIGHT_smoker || smoking_status4 == HEAVY_smoker)
			+ interactions[DEMPORT_INTER_AGE_SMOKER_FORMER_LT5] * (smoking_status4 == FORMER_smoker)*(time_since_quit_smoking < 4)
			+ interactions[DEMPORT_INTER_AGE_SMOKER_FORMER_GT5] * (smoking_status4 == FORMER_smoker)*(time_since_quit_smoking >= 4)
			+ interactions[DEMPORT_INTER_AGE_PACK_YEARS] * total_packyears_smoked
			+ interactions[DEMPORT_INTER_AGE_DRINK_FORMER] * (gAlcohol5 == ALCOHOL_FORMER)
			+ interactions[DEMPORT_INTER_AGE_DRINKS_LAST_WEEK] * number_drinks_past_week
			+ interactions[DEMPORT_INTER_AGE_PA_MET] * physical_activity_met
			+ interactions[DEMPORT_INTER_AGE_BMI] * gBMI4_dementia
			+ interactions[DEMPORT_INTER_AGE_HYPERTENSION] * (gBP_PA == HIGH_BP_YES)
			+ interactions[DEMPORT_INTER_AGE_DIABETES] * (gDiabetes_use == DIAB_YES)
			+ interactions[DEMPORT_INTER_AGE_HEART_DISEASE] * (acute_myocardial_infract == CVDPORT_AMI_YES)
			+ interactions[DEMPORT_INTER_AGE_STROKE] * (stroke == CVDPORT_STROKE_YES);


		hazard = hazard - mgDementiaSumInteractionCoefMeanCovariate[sex];   // got ( sum_k   coef_k  * Xk -  sum_k   coef_k  * mean_Xk  )  so far
		hazard *= (lifespan_age - DementiaAgeSplineCompanion[sex][CUBIC_SPLINE_COMPANION_CENTER_LINEAR_TERM]);  //DementiaAgeSplineCompanion[sex][..] contains mean age
		//END Step 1: sum_k   coef_k * (age - mean_age ) * (Xk - mean_Xk)  =  (age - mean_age ) * ( sum_k   coef_k  * Xk -  sum_k   coef_k  * mean_Xk  )

		//BEGIN Step 2: add on sum_k   coef_k *  (Xk - mean_Xk)  =   ( sum_k   coef_k  * Xk -  sum_k   coef_k  * mean_Xk  ) over main terms (interactions and splines excluded)
		hazard = hazard
			+ main_coefs[DEMPORT_MAIN_SMOKER_CURRENT] * (smoking_status4 == LIGHT_smoker || smoking_status4 == HEAVY_smoker)
			+ main_coefs[DEMPORT_MAIN_SMOKER_FORMER_LT5] * (smoking_status4 == FORMER_smoker)*(time_since_quit_smoking <  4)
			+ main_coefs[DEMPORT_MAIN_SMOKER_FORMER_GT5] * (smoking_status4 == FORMER_smoker)*(time_since_quit_smoking >= 4)
			+ main_coefs[DEMPORT_MAIN_DRINK_FORMER] * (gAlcohol5 == ALCOHOL_FORMER)
			+ main_coefs[DEMPORT_MAIN_ETHNICITY] * (gEthnicityNonWhite == ETHNICITY_NONWHITE) // DH check this
			+ main_coefs[DEMPORT_MAIN_EDUC_HIGH_SCHOOL_GRAD] * (gEducation == EDUC2)
			+ main_coefs[DEMPORT_MAIN_EDUC_SOME_PS] * (gEducation == EDUC3)
			+ main_coefs[DEMPORT_MAIN_EDUC_PS_GRAD] * (gEducation == EDUC4)
			+ main_coefs[DEMPORT_MAIN_HYPERTENSION] * (gBP_PA == HIGH_BP_YES)
			+ main_coefs[DEMPORT_MAIN_DIABETES] * (gDiabetes_use == DIAB_YES) // added sum_k   coef_k  * Xk   so far
			+ main_coefs[DEMPORT_MAIN_HEART_DISEASE] * (acute_myocardial_infract == CVDPORT_AMI_YES)
			+ main_coefs[DEMPORT_MAIN_STROKE] * (stroke == CVDPORT_STROKE_YES);

		hazard = hazard - mgDementiaSumMainTermsCoefMeanCovariate[sex];   // substract sum_k   coef_k  * mean_Xk    so step 2 is done
		//END   Step 2: add on sum_k   coef_k *  (Xk - mean_Xk)  =   ( sum_k   coef_k  * Xk -  sum_k   coef_k  * mean_Xk  ) over main terms (interactions and splines excluded)

		//BEGIN Step 3: add on splines to complete the computation of DEMPORT's score  
		hazard = hazard
			+ dementia_spline_age
			+ dementia_spline_bmi
			+ dementia_spline_pack_years
			+ dementia_spline_alcohol
			+ dementia_spline_met;

		hazard = hazard + DementiaAlterationSpecs[sex][SPLIT(lifespan_age, FROM_25_TO_90_BY_5)];
		hazard = hazard + DementiaAlterationSpecsBeforeSlope[sex][SPLIT(lifespan_age, FROM_25_TO_90_BY_5)] * (year - DementiaTemporalBendingPoint) * (year < DementiaTemporalBendingPoint);
		hazard = hazard + DementiaAlterationSpecsAfterSlope[sex][SPLIT(lifespan_age, FROM_25_TO_90_BY_5)] * (year - DementiaTemporalBendingPoint) * (year > DementiaTemporalBendingPoint);

		//END   Step 3: add on splines to complete the computation of DEMPORT's score  (at this point, local variable hazard contains DEMPORT's score)

		hazard = exp(hazard); //  hazard = baseline * exp(score) with baseline handled below.

		if (DementiaBaseline[sex] >= 0)
			hazard *= DementiaBaseline[sex] / 5.0; //baseline = 5 year cumulative hazard / 5. 
		else
		{
			double log_cum_haz_age, log_cum_haz_agep1;

			log_cum_haz_age = PieceLinearLookup(lifespan_age, DementiaLogBaseCumulativeHazard[sex][COORDINATES_X],
				DementiaLogBaseCumulativeHazard[sex][COORDINATES_Y], SIZE(SCATTER_PLOT_ELEMENTS));
			log_cum_haz_agep1 = PieceLinearLookup(lifespan_age + 1, DementiaLogBaseCumulativeHazard[sex][COORDINATES_X],
				DementiaLogBaseCumulativeHazard[sex][COORDINATES_Y], SIZE(SCATTER_PLOT_ELEMENTS));

			hazard *= (exp(log_cum_haz_agep1) - exp(log_cum_haz_age)); //baseline hazard over [age,age+1] = H(age+1)-H(age)
		}

		if (dementia == DEMENTIA_NO)
			time_next = WAIT(-TIME(log(RandUniform(138)) / hazard));

		if (EcrireDebugLogEntry == 4  && CasesDebugLogEntry[LOWER_BOUND] <= case_id && case_id <= CasesDebugLogEntry[UPPER_BOUND])
		{
			char line[999];
			snprintf(line, 999, "%i, %15.1f, %15.9f, %i, %i, %15.9f, %15.9f, %15.9f, %15.9f, %15.9f, %i, %i, %i, %i, %i, %i, %i, %i, %i, %i, %i, %i, %15.9f, %15.9f, %15.9f, %15.9f, %15.9f, %15.9f  \n", (int)case_id, (double)case_seed, WAIT(0), int(dementia == DEMENTIA_YES), int(sex), double(lifespan_age), double(total_packyears_smoked), double(number_drinks_past_week), double(physical_activity_met), double(gBMI4_dementia), int(smoking_status4 == LIGHT_smoker || smoking_status4 == HEAVY_smoker), int((smoking_status4 == FORMER_smoker) * (time_since_quit_smoking < 4)), int((smoking_status4 == FORMER_smoker) * (time_since_quit_smoking >= 4)), int(gAlcohol5 == ALCOHOL_FORMER), int(gEthnicityNonWhite == ETHNICITY_NONWHITE), int(gEducation == EDUC2), int(gEducation == EDUC3), int(gEducation == EDUC4), int(gDiabetes_use == DIAB_YES), int(gBP_PA == HIGH_BP_YES), int(acute_myocardial_infract == CVDPORT_AMI_YES), int(stroke == CVDPORT_STROKE_YES), double(dementia_spline_age), double(dementia_spline_pack_years), double(dementia_spline_alcohol), double(dementia_spline_met), double(dementia_spline_bmi), hazard);
			WriteDebugLogEntry(line);
		}	

	} 


	return time_next;
};

/* ProgrammersNote for event timeDementiaDiseaseEvent, DementiaDiseaseEvent
* If triggered, the event will be called 3 times
  1. First call. This is the natural call for dementia incidence. 
     - dementia is set to DEMENTIA_YES.  This will contribute to tables involving entrances(dementia, DEMENTIA_YES).
	 - "A costs" are **set** for tables tDiagnosis_Year_Costs_For_Dementia and tYear_Before_Diagnosis_Costs_For_Dementia.  Increment from 0 to Z will contribute (Z-0) to tabulation.
	 - tabulate_dementia_cost_in_this_time_cat is set to YEAR_BEFORE_DIAGNOSIS.
	 - "B costs" are **incremented** for table tDementia_Costs.  Increment from 0 to X will contribute (X-0) to tabulation in the YEAR_BEFORE_DIAGNOSIS slice.
  2. Second call.  Same time as first call ... but later   :-)
	 - dementia is set to DEMENTIA_YES again.  This will contribute nothing to tables involving entrances(dementia, DEMENTIA_YES).
	 - "A costs" are **set** for tables tDiagnosis_Year_Costs_For_Dementia and tYear_Before_Diagnosis_Costs_For_Dementia.  Costs go from Z to Z so this contributes (Z-Z=0, i.e. nothing) to those tables.
	 - tabulate_dementia_cost_in_this_time_cat is set to DIAGNOSIS_YEAR.
	 - "B costs" are **incremented** for table tDementia_Costs.  Increment from X to Y will contribute (Y-X) to tabulation in the DIAGNOSIS_YEAR slice.
  3. Third call.  Same time as second call ... but later   :-)
	 - dementia is set to DEMENTIA_YES again.  This will contribute nothing to tables involving entrances(dementia, DEMENTIA_YES).
	 - "A costs" are **set** for tables tDiagnosis_Year_Costs_For_Dementia and tYear_Before_Diagnosis_Costs_For_Dementia.  Costs go from Z to Z so this contributes (Z-Z=0, i.e. nothing) to those tables.
	 - tabulate_dementia_cost_in_this_time_cat is set to PROGRESSION.  This is the value it had prior to the event cascade.  
	   This insures that weighted_duration(dementia_physician_progression) goes in tDementia_Costs's PROGRESSION slice as time goes by in the future.
	 - "B costs" are left unchanged so no impact on table tDementia_Costs.  
*/

void hook_DementiaDiseaseEvent() {};

void Person::DementiaDiseaseEvent()
{
	if (EcrireDebugLogEntry == 44 && CasesDebugLogEntry[LOWER_BOUND] <= case_id && case_id <= CasesDebugLogEntry[UPPER_BOUND] && dementia != DEMENTIA_YES)
	{
		//std::stringstream ss;
		//ss << "\nIncidence, " << case_seed << ", " << dementia_initial_altered << ", " << dementia;
		//WriteDebugLogEntry(ss.str().c_str());
		char line[199];
		snprintf(line, 199, "%i, %15.1f, Incidence, %15.9f, %15.9f, %i, %i  \n", (int)case_id, (double)case_seed, (double)time, (double)age, int(dementia_initial_altered), (int)1); // dementia will be set to TRUE below
		WriteDebugLogEntry(line);
	}
	dementia = DEMENTIA_YES;
	dementia_time_begin = time;
	age_at_dementia_onset = age;
//BEGIN So-called "costs A" for tDiagnosis_Year_Costs_For_Dementia and tYear_Before_Diagnosis_Costs_For_Dementia
	dementia_physician_diagnosis = DementiaPhysicianCosts[sex][SPLIT(lifespan_age,FROM_25_TO_90_BY_5)][dementia][DIAGNOSIS_YEAR];
	dementia_prescription_diagnosis = DementiaPrescriptionDrugs[sex][SPLIT(lifespan_age,FROM_25_TO_90_BY_5)][dementia][DIAGNOSIS_YEAR];
	dementia_hospital_admissions_diagnosis = DementiaHospitalAdmissions[sex][SPLIT(lifespan_age,FROM_25_TO_90_BY_5)][dementia][DIAGNOSIS_YEAR];
	dementia_homecare_diagnosis = DementiaHomeCare[sex][SPLIT(lifespan_age,FROM_25_TO_90_BY_5)][dementia][DIAGNOSIS_YEAR];
	dementia_longtermcare_diagnosis = DementiaLongTermCare[sex][SPLIT(lifespan_age,FROM_25_TO_90_BY_5)][dementia][DIAGNOSIS_YEAR];
	dementia_assistive_devices_diagnosis = DementiaAssistiveDevices[sex][SPLIT(lifespan_age,FROM_25_TO_90_BY_5)][dementia][DIAGNOSIS_YEAR];

	dementia_physician_year_before_diagnosis = DementiaPhysicianCosts[sex][SPLIT(lifespan_age,FROM_25_TO_90_BY_5)][dementia][YEAR_BEFORE_DIAGNOSIS];
	dementia_prescription_year_before_diagnosis = DementiaPrescriptionDrugs[sex][SPLIT(lifespan_age,FROM_25_TO_90_BY_5)][dementia][YEAR_BEFORE_DIAGNOSIS];
	dementia_hospital_admissions_year_before_diagnosis = DementiaHospitalAdmissions[sex][SPLIT(lifespan_age,FROM_25_TO_90_BY_5)][dementia][YEAR_BEFORE_DIAGNOSIS];
	dementia_homecare_year_before_diagnosis = DementiaHomeCare[sex][SPLIT(lifespan_age,FROM_25_TO_90_BY_5)][dementia][YEAR_BEFORE_DIAGNOSIS];
	dementia_longtermcare_year_before_diagnosis = DementiaLongTermCare[sex][SPLIT(lifespan_age,FROM_25_TO_90_BY_5)][dementia][YEAR_BEFORE_DIAGNOSIS];
	dementia_assistive_devices_year_before_diagnosis = DementiaAssistiveDevices[sex][SPLIT(lifespan_age,FROM_25_TO_90_BY_5)][dementia][YEAR_BEFORE_DIAGNOSIS];
//END So-called "costs A" for tDiagnosis_Year_Costs_For_Dementia and tYear_Before_Diagnosis_Costs_For_Dementia

//BEGIN for tDementia_Costs 
	//BEGIN Need to do one of the following : (i) PROGRESSION --> YEAR_BEFORE_DIAGNOSIS, (ii) YEAR_BEFORE_DIAGNOSIS --> DIAGNOSIS_YEAR , (iii)  DIAGNOSIS_YEAR --> PROGRESSION
	DEMENTIA_TIME_CAT new_tabulate_dementia_cost_in_this_time_cat = END_OF_LIFE; //Stop if still see this value after code below

	if (tabulate_dementia_cost_in_this_time_cat == DIAGNOSIS_YEAR)
		new_tabulate_dementia_cost_in_this_time_cat = PROGRESSION;

	if (tabulate_dementia_cost_in_this_time_cat == YEAR_BEFORE_DIAGNOSIS)
		new_tabulate_dementia_cost_in_this_time_cat = DIAGNOSIS_YEAR;

	if (tabulate_dementia_cost_in_this_time_cat == PROGRESSION)
		new_tabulate_dementia_cost_in_this_time_cat = YEAR_BEFORE_DIAGNOSIS;

	tabulate_dementia_cost_in_this_time_cat = new_tabulate_dementia_cost_in_this_time_cat;

	if (new_tabulate_dementia_cost_in_this_time_cat == END_OF_LIFE)
		ModelExit("\nUnexpected value in DementiaDiseaseEvent\n");
	  //END Need to do one of the following : (i) PROGRESSION --> YEAR_BEFORE_DIAGNOSIS, (ii) YEAR_BEFORE_DIAGNOSIS --> DIAGNOSIS_YEAR , (iii)  DIAGNOSIS_YEAR --> PROGRESSION

	if (tabulate_dementia_cost_in_this_time_cat == YEAR_BEFORE_DIAGNOSIS || tabulate_dementia_cost_in_this_time_cat == DIAGNOSIS_YEAR)
	{  // So-called "costs B" for tDementia_Costs
		punctual_dementia_costs_physician           += DementiaPhysicianCosts    [sex][SPLIT(lifespan_age, FROM_25_TO_90_BY_5)][dementia][tabulate_dementia_cost_in_this_time_cat];
		punctual_dementia_costs_prescription        += DementiaPrescriptionDrugs [sex][SPLIT(lifespan_age, FROM_25_TO_90_BY_5)][dementia][tabulate_dementia_cost_in_this_time_cat];
		punctual_dementia_costs_hospital_admissions += DementiaHospitalAdmissions[sex][SPLIT(lifespan_age, FROM_25_TO_90_BY_5)][dementia][tabulate_dementia_cost_in_this_time_cat];
		punctual_dementia_costs_homecare            += DementiaHomeCare          [sex][SPLIT(lifespan_age, FROM_25_TO_90_BY_5)][dementia][tabulate_dementia_cost_in_this_time_cat];
		punctual_dementia_costs_longtermcare        += DementiaLongTermCare      [sex][SPLIT(lifespan_age, FROM_25_TO_90_BY_5)][dementia][tabulate_dementia_cost_in_this_time_cat];
		punctual_dementia_costs_assistive_devices   += DementiaAssistiveDevices  [sex][SPLIT(lifespan_age, FROM_25_TO_90_BY_5)][dementia][tabulate_dementia_cost_in_this_time_cat];
	}
	
//END   for tDementia_Costs

	hook_DementiaDiseaseEvent();
};



void PreSimulation()
{
	//BEGIN  check alignment of DEMPORT_INTERACTION_TERMS and DEMPORT_MAIN_TERMS
	if (DEMPORT_INTER_AGE_SMOKER_CURRENT != DEMPORT_MAIN_SMOKER_CURRENT) ModelExit("DEMPORT_INTER_AGE_SMOKER_CURRENT      != DEMPORT_MAIN_SMOKER_CURRENT     .");
	if (DEMPORT_INTER_AGE_SMOKER_FORMER_LT5 != DEMPORT_MAIN_SMOKER_FORMER_LT5) ModelExit("DEMPORT_INTER_AGE_SMOKER_FORMER_LT5   != DEMPORT_MAIN_SMOKER_FORMER_LT5  .");
	if (DEMPORT_INTER_AGE_SMOKER_FORMER_GT5 != DEMPORT_MAIN_SMOKER_FORMER_GT5) ModelExit("DEMPORT_INTER_AGE_SMOKER_FORMER_GT5   != DEMPORT_MAIN_SMOKER_FORMER_GT5  .");
	if (DEMPORT_INTER_AGE_DRINK_FORMER != DEMPORT_MAIN_DRINK_FORMER) ModelExit("DEMPORT_INTER_AGE_DRINK_FORMER        != DEMPORT_MAIN_DRINK_FORMER       .");
	if (DEMPORT_INTER_AGE_HEART_DISEASE != DEMPORT_MAIN_HEART_DISEASE) ModelExit("DEMPORT_INTER_AGE_HEART_DISEASE        != DEMPORT_MAIN_HEART_DISEASE       .");
	if (DEMPORT_INTER_AGE_STROKE != DEMPORT_MAIN_STROKE) ModelExit("DEMPORT_INTER_AGE_STROKE            != DEMPORT_MAIN_STROKE           .");
	if (DEMPORT_INTER_AGE_HYPERTENSION != DEMPORT_MAIN_HYPERTENSION) ModelExit("DEMPORT_INTER_AGE_HYPERTENSION        != DEMPORT_MAIN_HYPERTENSION       .");
	if (DEMPORT_INTER_AGE_DIABETES != DEMPORT_MAIN_DIABETES) ModelExit("DEMPORT_INTER_AGE_DIABETES            != DEMPORT_MAIN_DIABETES           .");
	
	/*These are the fake interaction terms- check with Claude whether this code is needed*/

	if (DEMPORT_INTER_AGE_ETHNICITY != DEMPORT_MAIN_ETHNICITY) ModelExit("DEMPORT_INTER_AGE_ETHNICITY        != DEMPORT_MAIN_ETHNICITY       .");
	if (DEMPORT_INTER_AGE_EDUC_HIGH_SCHOOL_GRAD != DEMPORT_MAIN_EDUC_HIGH_SCHOOL_GRAD) ModelExit("DEMPORT_INTER_AGE_EDUC_HIGH_SCHOOL_GRAD            != DEMPORT_MAIN_EDUC_HIGH_SCHOOL_GRAD           .");
	if (DEMPORT_INTER_AGE_EDUC_SOME_PS != DEMPORT_MAIN_EDUC_SOME_PS) ModelExit("DEMPORT_INTER_AGE_EDUC_SOME_PS        != DEMPORT_MAIN_EDUC_SOME_PS       .");
	if (DEMPORT_INTER_AGE_EDUC_PS_GRAD != DEMPORT_MAIN_EDUC_PS_GRAD) ModelExit("DEMPORT_INTER_AGE_EDUC_PS_GRAD            != DEMPORT_MAIN_EDUC_PS_GRAD           .");
	

	//END   check alignment of DEMPORT_INTERACTION_TERMS and DEMPORT_MAIN_TERMS


	for (int sex_looper = 0; sex_looper<SIZE(SEX); sex_looper++)
	{
		//BEGIN get mgDementiaSumMainTermsCoefMeanCovariate[sex_looper]
		mgDementiaSumMainTermsCoefMeanCovariate[sex_looper] = 0;
		for (int x_looper = 0; x_looper<SIZE(DEMPORT_MAIN_TERMS); x_looper++)
			mgDementiaSumMainTermsCoefMeanCovariate[sex_looper] += DementiaMainTermsCoefficients[sex_looper][x_looper] * DementiaMainTermsMeans[sex_looper][x_looper];
		//END   get mgDementiaSumMainTermsCoefMeanCovariate[sex_looper]

		//BEGIN get mgDementiaSumInteractionCoefMeanCovariate[sex_looper] 
		mgDementiaSumInteractionCoefMeanCovariate[sex_looper] = 0;
		for (int x_looper = 0; x_looper<SIZE(DEMPORT_MAIN_TERMS); x_looper++)  // NOTA BONE alignment of DEMPORT_INTERACTION_TERMS and DEMPORT_MAIN_TERMS and used here
			mgDementiaSumInteractionCoefMeanCovariate[sex_looper] += DementiaInteractionCoefficients[sex_looper][x_looper] * DementiaMainTermsMeans[sex_looper][x_looper];

		//Need to add on PackYears, DrinksLastWeek, MET, BMI not covered above
		mgDementiaSumInteractionCoefMeanCovariate[sex_looper] += DementiaInteractionCoefficients[sex_looper][DEMPORT_INTER_AGE_PACK_YEARS] * DementiaPackYearsSplineCompanion[sex_looper][CUBIC_SPLINE_COMPANION_CENTER_LINEAR_TERM];
		mgDementiaSumInteractionCoefMeanCovariate[sex_looper] += DementiaInteractionCoefficients[sex_looper][DEMPORT_INTER_AGE_DRINKS_LAST_WEEK] * DementiaDrinksSplineCompanion[sex_looper][CUBIC_SPLINE_COMPANION_CENTER_LINEAR_TERM];
		mgDementiaSumInteractionCoefMeanCovariate[sex_looper] += DementiaInteractionCoefficients[sex_looper][DEMPORT_INTER_AGE_PA_MET] * DementiaMetsSplineCompanion[sex_looper][CUBIC_SPLINE_COMPANION_CENTER_LINEAR_TERM];
		mgDementiaSumInteractionCoefMeanCovariate[sex_looper] += DementiaInteractionCoefficients[sex_looper][DEMPORT_INTER_AGE_BMI] * DementiaBmiSplineCompanion[sex_looper][CUBIC_SPLINE_COMPANION_CENTER_LINEAR_TERM];

		//END   get mgDementiaAmiSumInteractionCoefMeanCovariate[sex_looper]

	}


};
