void Person::ReadFromStartPop()
{
		// NB pStartPop should be CLEAN on input to the simulation
		// ie, it should not contain in invalid codes - simulation will not check


	const double *record_to_be_read;
	record_to_be_read = FictivePersonCharacteristics[ROW_1][cDb_Weight] < 0.0 ? pStartPop[cchs_record] : FictivePersonCharacteristics[ROW_1] ;

	gEthnicityNonWhite   = ( ETHNICITY             ) int(record_to_be_read[cDb_Ethnicity]);
	gCulturalOrigin      = ( CULTURAL_ORIGIN       ) int(record_to_be_read[cDb_CulturalOrigin]); // NEW feb 2008
	gAboriginal          = (gCulturalOrigin == CULTURAL_ORIGIN_ABORIGINAL ) ? ABORIGINAL_YES : ABORIGINAL_NO ;

	gEducation_startpop  = ( EDUCATION             ) int(record_to_be_read[cDb_Education]);
	gEducation           = ( EDUCATION             ) int(record_to_be_read[cDb_Education]);
	gIncomeQuartile      = ( INCOME_QUARTILE       ) int(record_to_be_read[cDb_IncomeQuartile]);

				 
	gHeight_m			=	(double					)	record_to_be_read[cDb_Height_m];	

	gArthritis           =                           int(record_to_be_read[cDb_Arthritis]); 
	gSROA                = ( logical               ) int(record_to_be_read[cDb_Osteoarthritis]); 
	gCHF                 =                           int(record_to_be_read[cDb_CHF]);
	gHeartBP             =                           int(record_to_be_read[cDb_SP_HBP]);
	gHeartAttack         =                           int(record_to_be_read[cDb_HeartAttack]);
	gHeartDisease        =                           int(record_to_be_read[cDb_SP_HRT]);
	gHeartAngina         =                           int(record_to_be_read[cDb_HeartAngina]);

	 

	/* This code is intended to establish AMI prevalence but has not been
	   fully thought through. Therefore, it is being commented out for now.
	   Calibration of AMI will be impacted. (Bill Feb 9, 2009)

	*if ( pDisease[DM_CAD_AMI][ROW_1] && 	
	 truncated_age >= MIN( CAD_AGE_RANGE ) && 
	 !IndexAMI_event ) 
	{
     //	if ( gHeartDisease || gHeartAttack ) {	
		if ( gHeartAttack ) {	
			gPrev_IndexAMI_event = TRUE;
			IndexAMIEvent();	// happened in past, so time to next events is not quite right
		}
	}
   */


	hook_ReadFromStartPop();
};

void hook_GetRecordYearAgeSexProvinceRegion() {};

void Person::GetRecordYearAgeSexProvinceRegion(  TIME *pAge, TIME *pTime)
{
	int nRecord    ;  // To eventually set actor state cchs_record.  
	int nYear, nAge;  // To eventually set actor state next_birthday, next_year, time (through *pTime) , age  (through *pAge) 
	int nSex       ;  // To eventually set actor state sex.
	int nProvince  ;  // To eventually set actor state gProvince.


		// ==========================================================
		// Case from pStartPop initialization database in start year
		// ==========================================================
		if ( population_source == cStartPop || FictivePersonCharacteristics[ROW_1][cDb_Weight] >= 0.0  ) 
		{
			// Determine which record to process from pStartPop.  Randomly select record, its probability based on survey sample weight  
			Lookup_mgCumStartPopWeight( RandUniform(79), &nRecord );

			const double *record_to_be_read;
			record_to_be_read = FictivePersonCharacteristics[ROW_1][cDb_Weight] < 0.0 ? pStartPop[nRecord] : FictivePersonCharacteristics[ROW_1] ;

			// start year
			nYear = pStartYear;								

			// age (integer)
			nAge = ConvertAgeGroup( record_to_be_read );

			nSex      = int(record_to_be_read[cDb_Sex     ]); 
			nProvince = int(record_to_be_read[cDb_Province]); 
//			nRegion   = int(record_to_be_read[cDb_Region  ]);
		
		}

		// ===================================================================
		// NEW BIRTHS generated in future year at youngest age represented on pStartPop
		//				not necessarly at birth)
		// ===================================================================
		else if ( population_source == cNewBirth ) 
		{ 
			int nProv;
			int nYoungestRecord;

			Lookup_mgBirth( RandUniform(83), &nSex, &nYear, &nProv);

			// year
			nYear = nYear + MIN( YEARS );

			// age
			nAge = mgYoungestAge;

			// Hot-deck imputation of other person characterictics from pStartPop
			// - Lookup donor from Immigrants on initialization db based on sex and age group
			// - Then translate the record number back to the initialization db to lookup init values
			Lookup_mgCumStartPopWeightYoungest( RandUniform(87), nSex, nProv, &nYoungestRecord ); 
			nRecord = mgStartPopYoungestDecode[nYoungestRecord]; 

			//record_to_be_read =  pStartPop[nRecord] ; this line would have been useful if record_to_be_read could have been declared as actor state (no need to assign it all the time)


			nProvince = int(pStartPop[nRecord][cDb_Province]);
//			nRegion   = int(pStartPop[nRecord][cDb_Region]);
		}

		// ===============================================
		// New immigrants
		// ===============================================
		else if ( population_source == cNewImmig ) 
		{	
			// Determine sex, year, age group, and province at immigration 
			Lookup_mgImmig( RandUniform(88), &nYear, &nSex, &nProvince, &nAge );

			// year
			nYear = nYear + MIN( YEARS );

			int nRegion = {0}    ;  
			if ( nProvince <=3 ) 
			{
				nRegion= 0 ; // ATLANTIC
			}
			else if ( nProvince == 4 ) 
			{
				nRegion= 1 ; // QUEBEC
			}
			else if ( nProvince == 5 ) 
			{
				nRegion= 2 ; // ON
			}
			else if ( nProvince >= 6 && nProvince <= 8 ) 
			{
				nRegion= 3 ; // Prairies
			}
			else 
			{
				nRegion= 4 ; // BCregion
			}


			// Translate the age into an age code for hot-deck imputation based on sex and age group
			int nAgeCode = 0;
			while  ( !( nAge >= pDbAgeDecode[nAgeCode][cDbBeginAge] &&
					    nAge <= pDbAgeDecode[nAgeCode][cDbEndAge] ) 
					 && ( nAgeCode < SIZE( DB_AGE_CODE ) - 1 ) ) 
			{
				nAgeCode++;	
			}

			// Hot-deck imputation of other person characterictics from pStartPop
			// - Lookup donor from Immigrants on initialization db based on sex and age group
			// - Then translate the record number back to the initialization db to lookup init values
			int nImmigRecord;
			if (Lookup_mgCumStartPopWeightImmig( RandUniform(89), nSex, nProvince, nAgeCode, &nImmigRecord ))
			{
				nRecord = mgStartPopImmigDecode[nSex][nAgeCode][nImmigRecord];
			}
			else if (Lookup_mgCumStartPopWeightImmigReg( RandUniform(8), nSex, nRegion, nAgeCode, &nImmigRecord ))
			{
				nRecord = mgStartPopImmigDecode[nSex][nAgeCode][nImmigRecord];
			}		
			else if (Lookup_mgCumStartPopWeightImmigCan( RandUniform(10), nSex, nAgeCode, &nImmigRecord )) 
			{
				nRecord = mgStartPopImmigDecode[nSex][nAgeCode][nImmigRecord];
			}
			else 
				ModelExit("No immigrant donor found.\n");
			//record_to_be_read =  pStartPop[nRecord] ; this line would have been useful if record_to_be_read could have been declared as actor state (no need to assign it all the time)
		}
		else
			ModelExit("Unexpected population_source.\n");
		
	//Finally set the actor states 
	//Set actor states cchs_record, gProvince, sex
	cchs_record = ( DB_RECORDS ) nRecord;
	sex         = ( SEX        ) nSex;
	gProvince   = ( PROVINCE   ) nProvince;

	
	if(FALSE)
	{
		char line[199];
		snprintf(line,199,"%i,%i,%i,%i,%i,%i \n",(int)case_id,(int)population_source , (int)nYear, (int)nAge, (int)nSex, (int)nRecord );
		WriteDebugLogEntry(line);
	}

	/* BEGIN set actor states next_birthday, next_year, age, time   */


	double dFractionOfYear;

	// Set the age and time for this person
	dFractionOfYear = RandUniform(393); // Draw a fractional part of year
	if ( pStartTimeMethod == cStart_BdayIsJan01 ) {
		// Start Jan 1st and make this the birthday for everyone
		*pAge = (TIME ) ( nAge );
		*pTime = (TIME) ( nYear );
		next_birthday = 1.0;
		next_year = 1.0;
	}
	else if ( ( pStartTimeMethod == cStart_Jan01 )
		&& ( nYear == pStartYear ) && (nAge > 0 ) )
	{	
		// Start on Jan 1st with floating birthday (except new borns and immigrants)
		*pAge = (TIME ) ( nAge - dFractionOfYear );
		*pTime = (TIME) ( nYear );
		next_birthday = dFractionOfYear;
		next_year = 1.0;
	}
	else { // (pStartTimeMethod == cStart_Bday) or new born or immigrant 
		// Start on birthday with floating date 
		*pAge = (TIME ) ( nAge );
		*pTime = (TIME) ( nYear + dFractionOfYear );
		next_birthday = 1.0;
		next_year = 1 - dFractionOfYear;
	}
	//age = CoarsenMantissa( *pAge ); // age  can only be set in the Start function, that's why age  is passed back to the Start function through the pointer *pAge
	//time = CoarsenMantissa(*pTime); // time can only be set in the Start function, that's why time is passed back to the Start function through the pointer *pTime

	/* END set actor states next_birthday, next_year, age, time   */

	hook_GetRecordYearAgeSexProvinceRegion();
};


// Assign nAge (integer) by converting nAgeCode
//	(note: in Start it is converted to a real number)
int Person::ConvertAgeGroup (const double *record_to_be_read ) 
{
	int nAge;
	logical lAgeNotAssigned; 
	double dRand;

	int nAgeCode, nProvince, nSex;	// or pass them ??
	nAgeCode  = (int) record_to_be_read[cDb_AgeGrp  ];
	nProvince = (int) record_to_be_read[cDb_Province];
	nSex      = (int) record_to_be_read[cDb_Sex     ];

	//Choose the random number once to be used to pick the age, either through population distribution or uniform method
	dRand = RandUniform(90);

	if ( pUseInputPopulationToAssignAge ) {
		/* Assign age within an age group based on the distribution of the
		population with same sex and province; pPOPULATION is converted to 
		mgCumPOPULATION to allow for within-age cumrate-like "lookup". 
		*/
		lAgeNotAssigned = TRUE;
		nAge = pDbAgeDecode[nAgeCode][cDbBeginAge];
		while ( lAgeNotAssigned && (nAge <= pDbAgeDecode[nAgeCode][cDbEndAge]) ) 
		{
			if ( dRand < mgCumPOPULATION[nProvince][nSex][nAge] ) 
			{
				lAgeNotAssigned = FALSE; //use current value of nAge
			}
			else 
			{	
				nAge++;
			}
		}
	}
	else {	
		// 	Choose age randomly within age group nAgeCode
		nAge = (int) pDbAgeDecode[nAgeCode][cDbBeginAge] 
			 +  int( dRand * ( pDbAgeDecode[nAgeCode][cDbEndAge]
								- pDbAgeDecode[nAgeCode][cDbBeginAge] + 1) );
	};
	return nAge;
};



/* NOTE(Person.Start,EN) 
	Initializes a new Person.
	>Persons can be initialized on (see bottom part of GetRecordYearAgeSexProvinceRegion)
	(1) on January 1st and force this to be birthday for everyone
	(2) on January 1st (excluding new borns and immigrants)
	(3) on their birthday sometime during the year (including new borns and immigrants)

	The data should be clean before arriving here (We could COERCE, but that may hide unclean data).
	Also would benefit from classification variables that make it clear the expected values as input.
	The StartPop SAS program needs to respect these definitions and be cleaned accordingly.
*/

void Person::Start( cPopulationSource lPopulationSource)
{
	// Initialize all attributes (OpenM++).
	initialize_attributes();

	dominant = TRUE;	//Maintained to provide consistent with historical model
	place_of_birth = lPopulationSource == cNewImmig &&  FictivePersonCharacteristics[ROW_1][cDb_Weight] < 0.0  ? ABROAD : CANADA;
	population_source = lPopulationSource;

	/* BEGIN set these actor states: cchs_record, sex, gProvince, gRegion, place_of_birth, next_birthday, next_year, time, age   */

	TIME starting_age;
	TIME starting_time;
	GetRecordYearAgeSexProvinceRegion(   &starting_age, &starting_time);
	age  = starting_age; 
	time = starting_time;
	
	// Initialize the integral age and year counters
	lifespan_age = COERCE(LIFE_SPAN, int( age ) );
	lifespan_age_start = lifespan_age;
	calendar_year = COERCE(YEARS , int( time ) );
	calendar_year_start = calendar_year;
	time_person_created = time;
	
	// Initialize birth date variables
	date_of_birth = time - age;
	year_of_birth = COERCE(YEAR, int( date_of_birth ));

	/* END set these actor states: cchs_record, sex, gProvince, gRegion, next_birthday, next_year, time, age   */

	//Since cchs_record has been assigned, we may now read stuff from CCHS
	ReadFromStartPop();  //Read the CCHS record.  Note that more reading takes place through functions hooked to ReadFromStartPop

	// Initialize other variables to be used in the transition 
	// of BP, chol and hdl at subsequent ages.
	diab = gDiabetes_use;

	GetTimingFirstUpdate();

	// INTERVENTION CODE FOR BMI AND SMOKING IS NOW HOOKED TO START
	// Initial values for BP, CHOL, HDL are imputed after Start using HOOK.

	hook_Start();

	// Have the entity enter the simulation (OpenM++).
	enter_simulation();
};

void hook_StartSnapshots() {};

void Person::StartSnapshots()
{
	//bmi4cat_measured_start      = (BMI_INDEX_ALL_AGES) bmi4cat_measured;
	bmi4cat_measured_start_PHAC = (BMI_INDEX_ALL_AGES) bmi4cat_measured_PHAC;

	hook_StartSnapshots();
};


TIME Person::timeEscapedStartEvent()
{
	TIME event_time = {TIME_INFINITE};  

	if ( !escaped_start ) // first time in this function
	{
		event_time = WAIT( 0.0 ); 
	}
	return event_time;
};

void hook_EscapedStartEvent() {};

void Person::EscapedStartEvent()
{
	escaped_start = TRUE;

	StartSnapshots();

	hook_EscapedStartEvent();
};

TIME Person::timeBirthdayEvent()
{
	return WAIT( next_birthday );
};

void Person::BirthdayEvent()
{
	next_birthday = 1.0;
	lifespan_age = COERCE(LIFE_SPAN, lifespan_age + 1 );

	hook_BirthdayEvent();
};

TIME Person::timeNewYearsEvent()
{
	return WAIT( next_year );
};

void Person::NewYearsEvent()
{
	next_year = 1.0;
	calendar_year = COERCE(YEARS, calendar_year + 1 );

	hook_NewYearsEvent();
};


/* NOTE(Person.Finish,EN) 
	Performs additional hidden processing when terminating a Person.
*/
void hook_Finish() {};

void Person::Finish()
{
	alive = FALSE;

	hook_Finish();

	// Have the entity exit the simulation (OpenM++).
	exit_simulation();
};

/* NOTE(Person.ImputeInitialStatesNotOnStartPop,EN) 
	Initialize Blood Pressure, Cholesterol and HDL at time Person is created (after Start)
	We use hot-deck imputation based on donor records of common variables 
	on Cdn Heart Health Surveys.
*/

void hook_ImputeInitialStatesNotOnStartPop() {};

void Person::ImputeInitialStatesNotOnStartPop()
{
	//MessageWhoWhenWhere(__FUNCTION__, 4==4);

	int     nAgeGroup = SPLIT( truncated_age, AGE_GROUP);
	int		nChol = {0};
	int		nHDL = {0};
	int		nBp = {0};

			
	// Initialization Blood Pressure category (hot-deck imputation)
	if ( Lookup_CumBPdistr( RandUniform( 14 ), gHeartBP, sex, nAgeGroup, &nBp ) )
	{
		bp_chhs = (BP_STATE) (nBp+1);
	}
	// Lookup failed, assign a category arbitrarily
	else 
	{
		bp_chhs = BP_MEDLOW;
	}
	bp_actual = bp_chhs;

	// Initialization Cholesterol category (hot-deck imputation)
        /*
	if ( Lookup_CumMargHRisk( RandUniform(28), sex, nAgeGroup, 
								bmi-1,diab,bp_chhs-1,&nChol) )
	{
		chol = (CHOL_STATE) (nChol+1);
	}
	// Lookup failed, assign a category arbitrarily
	else 
	{
		chol = 	CHOL_MED;
	};
	cholF = chol ;
	*/
	// Initialization HDL category (hot-deck imputation)
    /*
	if ( Lookup_CumHDLdistr( RandUniform(15), sex, nAgeGroup, 
								(chol-1), diab, (bmi-1), &nHDL ) )
	{
		hdl = (HDL_STATE) (nHDL+1);
	}
	
	// Lookup failed, assign a category arbitrarily
	else 
	{ 
		hdl = 	HDL_MED;
	}
	*/
	// Assign exact initial values for BP, CHOL and HDL
	//AssignExactValueForBpCholHDL();

	hook_ImputeInitialStatesNotOnStartPop();
};




