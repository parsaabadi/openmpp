void Person::COPD_person_random_variable()
{    
	
	
	{
   
	// Random numbers for log hazard of exacerbations from Mohsen's regression on MACRO dataset
   
	x_inc_male=0.557*RandNormal(163);
	x_inc_female =0.3789*RandNormal(164);
	x_prev_male = 0.6147*RandNormal(165);
	x_prev_female = 0.4328*RandNormal(166);



	
	/* 
	 double mu_x_exac1= 0.5931;
	 double mu_x_exac2= 2.61;
	 double std_x_exac1= 0.06330; 
	 double std_x_exac2= 0.5706; 
	 //double cov_exac= -0.02713;
	 double ro_exac= -0.7511; //-0.02713/(0.06330*0.5706);

	 x_exac1=RandNormal(137);
	 x_exac2=ro_exac*x_exac1+sqrt(1-ro_exac*ro_exac)*RandNormal(138);
	 x_exac1=mu_x_exac1+std_x_exac1*x_exac1;
	 x_exac2=mu_x_exac2+std_x_exac2*x_exac2; */	 
	   
	 
	 //----------------------------------------------------
	 
//	 x_exac_stage = sqrt(2.6144)*RandNormal(1089);
	 x_exac_severity = 1.442*RandNormal(1090);                     // Random number for the severity of exacerbation

	 RAND_TAIL_FEV1_t = std::abs(sqrt(0.1845)*RandNormal(1087)+ 0.827);
	 x_rate_exacerbation_random_effect= sqrt(0.55)*RandNormal(167);
	}
}

double  Person::ComputeXBeta(const double *beta, logical use_base_covar)
{
	double this_age, this_mass, this_PY;

	if (use_base_covar)
	{
		this_age  = age_base;
		this_mass = gMass_kg_base;
		this_PY   = pkyr_base;
	}
	else
	{
		this_age  = double(integer_age);
		this_mass = gBMI;
		this_PY   = PY;
	}

	return 
		      beta[COPD_EQ_INTERCEPT      ] 
		    + beta[COPD_EQ_AGE            ] * this_age
	    	+ beta[COPD_EQ_AGE_SQ         ] * this_age * this_age
		    + beta[COPD_EQ_WEIGHT         ] * this_mass
		    + beta[COPD_EQ_HEIGTH         ] * gHeight_m
		    + beta[COPD_EQ_HEIGTH_SQ      ] * gHeight_m * gHeight_m
		    + beta[COPD_EQ_HEIGTH_SQ_AGE  ] * gHeight_m * gHeight_m * this_age
		    + beta[COPD_EQ_SMOKING_CURRENT] * (smoking_status3 == SMOKING_STATE3_CURRENT)
		    + beta[COPD_EQ_SMOKING_PY     ] * this_PY
		    + beta[COPD_EQ_FEV            ] * FEV1_t
		    + beta[COPD_EQ_DURATION       ] * time_with_copd;
}
void Person:: copd_check()
{	
  // EN Calculating COPD hazard from Amin's equation- Sep 25th 2017
						
		// EN Calculating COPD hazard from Amin's equation- July 26th 2017
  log_Hazard_copd = (copd_stage == COPD_STAGE0 && integer_age >= 40) ? ComputeXBeta(CopdHazard[sex],FALSE) : -100000;		 
		  
  copd_hazard = exp(log_Hazard_copd);

  // EN log of exacerbation hazard from Mohsen (Macro) and gold stages 
  
  double            log_exac_hazard;    //EN log of hazard of exacerbation as a function of age and GOLD stages (calibration) 
  
  log_exac_hazard =  ( has_copd ==TRUE && sex == MALE )   ? intercept_exac_hazard + 0.04082*0.1*(integer_age) +COPD_exac_hazard[copd_stage]+ x_rate_exacerbation_random_effect: 
	                 ( has_copd ==TRUE && sex == FEMALE ) ? intercept_exac_hazard + 0.04082*0.1*(integer_age) +COPD_exac_hazard[copd_stage]+ x_rate_exacerbation_random_effect: -10000; 
  
  exac_hazard = exp(log_exac_hazard);

  if (copd_stage == COPD_STAGE1 && exac_hazard >= 0.4 && diagnosed_COPD == FALSE) {diagnosed_COPD = TRUE;}  
  if (copd_stage == COPD_STAGE2 && exac_hazard >= 0.7 && diagnosed_COPD == FALSE) {diagnosed_COPD = TRUE;}  
  if (copd_stage == COPD_STAGE3 && exac_hazard >= 0.8 && diagnosed_COPD == FALSE) {diagnosed_COPD = TRUE;}  
  if (copd_stage == COPD_STAGE4 && exac_hazard >= 0.3 && diagnosed_COPD == FALSE) {diagnosed_COPD = TRUE;}   
} 

TIME  Person::timeYearsLivedWithCOPDEvent()
{	
	TIME 	event_time = { TIME_INFINITE };

	if ( has_copd ) 
	{
		event_time = WAIT( TIME( 1.0 ));

	}
	return  event_time; 
}


void  Person::YearsLivedWithCOPDEvent()
{
	time_with_copd = (has_copd_incidence == TRUE )? COERCE( REPORT_TIME_WITH_COPD, time_with_copd +1): COERCE( REPORT_TIME_WITH_COPD, calendar_year - calendar_year_start +1) ; 
} 


TIME Person::timeCOPDincidence()

{   
	if (!pDisease[DM_COPD][ROW_1] || has_copd_incidence == TRUE || has_copd_initially == TRUE || log_Hazard_copd < -100) {

        return TIME_INFINITE; // EN Return Time to infinit if the person already has COPD, incidence should not be considered for this person

    }  else {

            if (copd_hazard > 0.0) {

                return WAIT(-log(RandUniform(1182)) / copd_hazard); // EN Time to get COPD

            } else {

				return TIME_INFINITE;

            }
	}
}


void Person::COPDincidenceEvent()     

{    
	if (alive == TRUE) {
       has_copd_incidence =  TRUE ; 
	   has_copd = TRUE;
	   time_copd_incidence = time;                                               // Recording the time of COPD incidence
	   age_base = age;
	   gMass_kg_base = gMass_kg ;
	   pkyr_base = PY;
	   FEV1incidence();
	   PEF_COPD_Stage();
	   copd_instant= TRUE;

	}
	
} 



TIME Person::timeCOPDexa()

{   
	if   ( has_copd == TRUE && has_exac == FALSE   ) 
	  {
		  if ( exac_hazard > 0.0 ) return WAIT(-log(RandUniform(5456))/exac_hazard);   // Time to Have exacerbation
		  else{ return TIME_INFINITE;}
	  }
     else{ return TIME_INFINITE;}
	
}

//void hook_COPDexaEvent() {}; //openM wants it but modgen does not like it.  Weird because it is fine with others (e.g. hook_InitializeAlcohol).  Comment out for now.

void Person::COPDexaEvent()
{    
	
	has_exac= TRUE;
    time_exac= time;
	exa_contour= exa_contour+1;
	
	double slop_adj = CopdExacerbationStage[copd_stage];
	double p_exac_stage_xbeta = ComputeXBeta(CopdExacerbation[sex],FALSE) + x_exac_severity + slop_adj;
	//p_exac_stage_xbeta = x_exac_severity+8;
	double abc= 1.6; //2.25;
	double po1= 1.091+abc;
	double po2= 1.902+abc;
	double po3= 5.208+abc;
                   
	double p1_exac_stage=1/(1+exp(-(p_exac_stage_xbeta+po1)));                                             //EN Probability of mild exacerbation
	double p2_exac_stage=1/(1+exp(-(p_exac_stage_xbeta+po2)))- 1/(1+exp(-(p_exac_stage_xbeta+po1)));       //EN Probability of moderate exacerbation
	double p3_exac_stage=1/(1+exp(-(p_exac_stage_xbeta+po3)))- 1/(1+exp(-(p_exac_stage_xbeta+po2)));       //EN Probability of severe exacerbation
	double p4_exac_stage=1-(p3_exac_stage+p2_exac_stage+p1_exac_stage);                                    //EN Probability of very severe exacerbation
	
	double            rand_exac;                             //EN Random number to determine the type(severity level) of exacerbation   
    rand_exac=RandUniform(168);
	if (rand_exac<p1_exac_stage)                                                                  	   {exac_stage=EXAC_STAGE1; }
	if (rand_exac>=p1_exac_stage && rand_exac<p2_exac_stage+p1_exac_stage)                             {exac_stage=EXAC_STAGE2; }
	if (rand_exac>=p2_exac_stage+p1_exac_stage && rand_exac<p3_exac_stage+p2_exac_stage+p1_exac_stage) {exac_stage=EXAC_STAGE3; }
	if (rand_exac>=(p3_exac_stage+p2_exac_stage+p1_exac_stage))                                        {exac_stage=EXAC_STAGE4; } 
	
	//gCost_COPD_exacerbation_test= gCost_COPD_exacerbation_test+ COPD_CostExacerbation[exac_stage];
	disqualy= disqualy+COPD_Exacerbation_disutility[copd_stage][exac_stage]; // icitte non-decreasing.  Is this what they intended?
	
	hook_COPDexaEvent();
}


TIME Person::timeCOPDexa_exit()
{
	if   ( has_exac == TRUE )
	{
		//return WAIT(0.0136); 
		return WAIT(0.0274);
	}
	else{ return TIME_INFINITE;}
}

void Person::COPDexa_exitEvent()
{    
	has_exac = FALSE;
	time_exac_exit= time-time_exac;
	exac_stage = EXAC_STAGE0;
	COPD_Mortality_probability=0;
	COPD_mortality_rate=-1000000;
	
} 

void	Person::COPDPrevalenceStartCheck()  
{
   
	double	          Initial_COPD_Probability;     //EN probability of having COPD at the begining of the simulation (prevalence) 

	if (pDisease[DM_COPD][ROW_1] &&  integer_age >= 40 &&  calendar_year == calendar_year_start)     
	{ 
		     // CanCOLD equation
			 double    ww = ComputeXBeta(CopdProb[sex],FALSE);		 
        	 Initial_COPD_Probability = 1/(1+exp(-ww)) ;   
	}
	else {Initial_COPD_Probability =0;}
  
	double unif = RandUniform(169);
	if      (unif <= Initial_COPD_Probability ) {
			   has_copd_initially= TRUE;
			   has_copd= TRUE;
	
			   FEV1 = ComputeXBeta(CopdFev1Prevalence[sex],FALSE) + (sex == FEMALE ? x_prev_female : x_prev_male);
			   			  
			   if (alive==TRUE)
				   
			   {
				   FEV1 = max(FEV1, RAND_TAIL_FEV1_t);
				   FEV1_t = FEV1;
			   }
			   else 
				   FEV1_t = 0;
           //-------------------------------- 
			   FEV1_base_prevalence=FEV1;
			   age_base = integer_age;
	           gMass_kg_base = gMass_kg;
			   pkyr_base = PY;
			   time_copd_incidence = time;
		       COPD_person_random_variable_FEV1();
			 

	}
	

};



void Person:: FEV1incidence()
{
	
 if (has_copd_incidence == TRUE && time_with_copd == 0)
 {
	if (alive == TRUE)
	{   /* FEV1 regression equation from CANCOLD based on LLN from NHANCES, the last term in the equation in the condition 
						     that FEV1/FVC is less than LLN of this ratio */
						  	                            
			 FEV1 = ComputeXBeta(CopdFev1Incidence[sex], TRUE) + (sex == FEMALE ? x_inc_female : x_inc_male);
			 FEV1_t = max(FEV1, RAND_TAIL_FEV1_t);

			 COPD_person_random_variable_FEV1();  			
	};
 };



}

void Person::COPD_mortality()   
{  

	if ( has_exac==TRUE  && has_copd == TRUE )
	{	 
	     COPD_mortality_rate = intercept_mortality+ log(1.05)*age + COPD_Mortality[exac_stage] ; 
		 COPD_Mortality_probability = 1/(1+exp(-1*COPD_mortality_rate));
	}
	else 
		COPD_Mortality_probability = 0;
  
    double x_rand_mortality_exa= RandUniform(170);

	if ( x_rand_mortality_exa <= COPD_Mortality_probability )
	{
		
		if (exac_stage == EXAC_STAGE1) {COPD_death_exac1= TRUE;}
	    if (exac_stage == EXAC_STAGE2) {COPD_death_exac2= TRUE;}
		if (exac_stage == EXAC_STAGE3) {COPD_death_exac3= TRUE;}
		if (exac_stage == EXAC_STAGE4) {COPD_death_exac4= TRUE;}
		
		COPD_death= TRUE;
		CheckFinish(MortalityEngine == MORTALITY_ENGINE_DEMOGRAPHY);  //This function call only kill if using MORTALITY_ENGINE_DEMOGRAPHY

	}

}


//void hook_FEV1_updateEvent() {};  //openM wants it but modgen does not like it.  Weird because it is fine with others (e.g. hook_InitializeAlcohol).  Comment out for now.

void Person::FEV1_updateEvent()   // Updating the value of FEV1 according to Zafar's equation
{  
	
    if ( has_copd_incidence == TRUE ||  has_copd_initially == TRUE )
	{
		//Zafar's cmaj equation
		
		if (alive==TRUE )
		{
			copd_instant= FALSE;	
			
			double  FEV1_slope;                   //EN FEV1 slope calculated from Zafar's CMAJ
			FEV1_slope = (intercept_2 + ComputeXBeta(CopdFev1Ongoing[sex],TRUE) ) * 0.001;

		    double  fv = FEV1+(FEV1_slope*time_with_copd);
			FEV1_t = max(fv, RAND_TAIL_FEV1_t);
		}
		else 
			FEV1_t = 0;
    };
    hook_FEV1_updateEvent();
 }


void Person::PEF_COPD_Stage() 
{
	PEF = ComputeXBeta(CopdPef[sex],FALSE) ;
	FEV1_PEF = (FEV1_t/PEF)*100;

	if ( (has_copd_incidence == TRUE && alive==TRUE ) || (has_copd_initially== TRUE && alive==TRUE ) )
	{
		if (FEV1_PEF >= 80) { copd_stage = COPD_STAGE1; }
		else if (FEV1_PEF >= 50 && FEV1_PEF < 80) { copd_stage = COPD_STAGE2; }
		else if (FEV1_PEF >= 30 && FEV1_PEF < 50) { copd_stage = COPD_STAGE3; }
		else if (FEV1_PEF < 30 && FEV1_PEF != 0 ) { copd_stage = COPD_STAGE4; }
	};
	
	
	if (has_copd == TRUE && calendar_year ==2015 && (smoking_status3 == SMOKING_STATE3_CURRENT || smoking_status3 == SMOKING_STATE3_FORMER) && PY >= 10 && FEV1_PEF <= 60 && age < 80 ) { clinical_sample_TORCH = TRUE; }
	if (has_copd == TRUE && calendar_year ==2015 && PY >= 10 && FEV1_PEF <= 70) { clinical_sample_UPLIFT = TRUE; }
	p_utility=COPD_UtilityGOLD[copd_stage]; 

}

