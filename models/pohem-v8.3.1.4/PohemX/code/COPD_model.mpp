#include "pohem.h"

//FILE_LABEL (EN) COPD
//The credit of COPD module goes to Shahzad Ghanbarian and Mohsen Sadatsafavi. 
//The COPD module is developed under CIHR grant for Evaluation Platform in COPD (EPIC) project (#142238) in Sep 2015-Dec 2018.
//EPIC is a discrete-event simulation model of Canadians 40 years of age or older. A complete description of the model can be 
//found in: 
//"Sadatsafavi M, Ghanbarian S, Adibi A, Johnson K, FitzGerald JM, Flanagan W, Bryan S, Sin D, Canadian Respiratory Research Network. 
//Development and validation of the Evaluation Platform In COPD (EPIC): a population-based outcomes model of COPD for Canada.  Medical Decision Making. 2019 Feb;39(2):152-67.

										
										
										
										


/* FILE_NOTE(EN) 
	This file implements prevalence and incidence of COPD.
*/

range       COPD_AGE_RANGE	            {40, 100};			                           //EN Range of ages 
range       COPD_YEAR_RANGE             {2001, 2050};
range	    REPORT_TIME_WITH_COPD		{0, 30};	                                   //EN Years lived with COPD 



classification COPD_STAGE {                      //EN COPD Stages 
	
	COPD_STAGE0,                                //EN Stage 0 means no COPD, 
	COPD_STAGE1,							    //EN Mild COPD, GOLD 1
	COPD_STAGE2,								//EN Moderate COPD, GOLD 2
	COPD_STAGE3,                                //EN Severe COPD, GOLD 3
	COPD_STAGE4                                 //EN Very severe COPD, GOLD 4
};

classification  COLLAPSED_COPD_STAGE {          // EN Collapsed COPD stages, we needed it at somepoint for the comparision with litrature

	C_COPD_STAGE0,                              // EN Stage 0 means no COPD 
    C_COPD_STAGE1,                              // EN Mild COPD
	C_COPD_STAGE2,                              // EN Moderate COPD	                             
	C_COPD_STAGE34                              // EN Severe or very severe COPD	
};

aggregation COLLAPSED_COPD_STAGE, COPD_STAGE
{
	C_COPD_STAGE0 , COPD_STAGE0,
	C_COPD_STAGE1 , COPD_STAGE1,
	C_COPD_STAGE2 , COPD_STAGE2,
	C_COPD_STAGE34, COPD_STAGE3,
	C_COPD_STAGE34, COPD_STAGE4
	
};


classification EXAC_STAGE {                      // EN Exacerbation Stages 
    
	EXAC_STAGE0,                                // EN No Exac 
	EXAC_STAGE1,							    // EN Mild Exac
	EXAC_STAGE2,								// EN Moderate Exac	
	EXAC_STAGE3,                                // EN Severe Exac
	EXAC_STAGE4                                 // EN Very severe 
};





classification COPD_DX_STATUS {	      // Diganosis has not modelled in a perfect way, it will be added later as part of Kate Johnson's PhD program
	   
	    COPD_YES,			// EN COPD has been diagnosed 
		COPD_NO	        	// EN COPD has not yet been diagnosed
	
};

classification FEV1_T_BETA {  
	     
	    CP_AGE_BASE,        // EN Baseline age
        CP_SEX,             // EN Sex 
		CP_WEIGHT_BASE,     // EN Baseline weight
		CP_HEIGHT,          // EN Height 
		CP_HEIGHT_SQ,       // EN Height squared 
		CP_SMOKING_ST,      // EN Smoking status  
		CP_HEIGHT_SQ_AGE,   // EN Height_square*age
		CP_FOLLOW_UP_YEAR   // EN Follow up year with COPD
};

classification COPD_EQUATION { //EN COPD equation
	COPD_EQ_INTERCEPT,       //EN Intercept
	COPD_EQ_AGE,             //EN Age
	COPD_EQ_AGE_SQ,          //EN Age squared
	COPD_EQ_WEIGHT,          //EN Weight 
	COPD_EQ_HEIGTH,          //EN Height 
	COPD_EQ_HEIGTH_SQ,       //EN Height squared
	COPD_EQ_HEIGTH_SQ_AGE,   //EN Height squared * Age
	COPD_EQ_SMOKING_CURRENT, //EN Current smoker
	COPD_EQ_SMOKING_PY,      //EN Pack years
	COPD_EQ_FEV,             //EN FEV1
	COPD_EQ_DURATION         //EN Time with copd

};

parameters {  //EN COPD parameter   these parameters will be showed in the parameter input so can be twicked without going through the code
	
	double intercept_exac_hazard;                                 //EN Intercept for COPD exacerbation hazard (calibration) 
	double intercept_mortality;                                   //EN COPD intercep for COPD_Mortality (calibration) 
	double COPD_Mortality[EXAC_STAGE];                            //EN COPD_Mortality coefficients per Exacerbation Stage (calibration)
	double COPD_exac_hazard[COPD_STAGE];                          //EN coefficients COPD exacerbation hazard per COPD stage Stage (calibration)
	double COPD_CostGOLD[COPD_STAGE];                             //EN COPD direct cost per GOLD stage per year
	double COPD_indirectCostGOLD[COPD_STAGE];                     //EN COPD indirect cost per GOLD stage per year
//	double COPD_CostExacerbation[COPD_STAGE][EXAC_STAGE];         //EN exacerbation cost by GOLD stage and exacerbation stage  
	double COPD_CostExacerbation[EXAC_STAGE];                     //EN exacerbation cost by GOLD stage and exacerbation stage   
    double COPD_UtilityGOLD[COPD_STAGE];                          //EN COPD utility per GOLD stage 
	double	Slope_FEV1_t_beta[SEX][FEV1_T_BETA];                  //EN FEV1 decline over time, Zafar's equation    
    double	COPD_Exacerbation_disutility[COPD_STAGE][EXAC_STAGE]; //EN Dis-Utility per GOLD stage per exacerbation

	double CopdProb           [SEX][COPD_EQUATION]; //EN Probability of COPD at start
	double CopdHazard         [SEX][COPD_EQUATION]; //EN COPD hazard

	double CopdFev1Base       [SEX][COPD_EQUATION]; //EN FEV1 coefficients for ordinary people  icitte
	double CopdFev1Prevalence [SEX][COPD_EQUATION]; //EN FEV1 coefficients for people with initially prevalent COPD 
	double CopdFev1Incidence  [SEX][COPD_EQUATION]; //EN FEV1 coefficients for people with incident COPD 
	double CopdFev1Ongoing    [SEX][COPD_EQUATION]; //EN FEV1 coefficients for people with ongoing COPD 
	double CopdPef            [SEX][COPD_EQUATION]; //EN PEF coefficients 

	double CopdExacerbation   [SEX][COPD_EQUATION]; //EN Excerbation stage
	double CopdExacerbationStage[COPD_STAGE];//EN Excerbation stage (COPD stage terms)
}; 

parameter_group pgCopdOnset{ //EN Onset
	 CopdProb,
	 CopdHazard
};
parameter_group pgCopdFev{ //EN FEV
	 CopdFev1Base,
	 CopdFev1Prevalence,
	 CopdFev1Incidence,
	 CopdFev1Ongoing,
	 CopdPef,
	 Slope_FEV1_t_beta
};
parameter_group pgCopdExacerbation{ //EN Exacerbation

	 intercept_exac_hazard,
	 COPD_exac_hazard,
	 CopdExacerbation,
	 CopdExacerbationStage
};
parameter_group pgCopdQaly{ //EN Utility/Mortality
	 COPD_UtilityGOLD,
	 COPD_Exacerbation_disutility,
	 intercept_mortality,
	 COPD_Mortality
};
parameter_group pgCopdCosts{ //EN Costs
	 COPD_CostGOLD,
	 COPD_indirectCostGOLD,
	 COPD_CostExacerbation
};
hide(Slope_FEV1_t_beta);
parameter_group pgCOPD{ //EN COPD
	pgCopdOnset,
	pgCopdFev,
	pgCopdExacerbation,
	pgCopdQaly,
	pgCopdCosts
};
//-----------------------------------------------------------------------------------------------------------------

actor Person            // Core Individual

{
	logical          has_copd_initially ={FALSE};                 //EN TRUE if person has COPD at the begining of the simulation 2002 
	logical          has_copd_incidence ={FALSE};                 //EN TRUE if peron develops COPD during his/her lifetime     
	logical          has_copd ={FALSE};                           //EN TRUE if person either has COPD at the begining of the simulation 2002 or developes it during his/her lifetime 
	logical          COPD_death ={FALSE};                         //EN TRUE if the person dies due to exacerbation  
	logical          has_exac ={FALSE};                            
	
	
	logical          COPD_death_exac1={FALSE};                    //EN COPD Death duo to mild exacerbation, it is zero but added for the purpose of calibration
	logical          COPD_death_exac2={FALSE};                    //EN COPD Death duo to moderate exacerbation, it is zero but added for the purpose of calibration 
	logical          COPD_death_exac3={FALSE};                    //EN COPD Death duo to severe exacerbation
	logical          COPD_death_exac4={FALSE};                    //EN COPD Death duo to very severe exacerbation 

		
	
	logical          clinical_sample_TORCH={FALSE};               //EN Flag for patients who have the inclusion criteria of TORCH clinical trial, it is added for External validation 
	logical          clinical_sample_UPLIFT={FALSE};              //EN Flag for patients who have the inclusion criteria of UPLIFT clinical trial, it is added for External validation
	logical          copd_instant ={FALSE};                       //EN it is the status of copd (incidence or prevalence) before updating FEV1 
	logical          diagnosed_COPD ={FALSE};                     //EN True if copd is diagnosed, the diagonisis is modelled for the sake of external validation and will be replaced late by Mohsen's team  



	double           FEV1={0};                                         //EN Initial value of FEV1 coming from Prevalnce or Incidence event
	double           FEV1_t={0};                                       //EN Updated value  of FEV1, updating happens every year at NewyearEvent
	double           FEV1_base_prevalence;                             //EN baseline value of FEV1 at creation  
	double           FEV1_base_incidence;                              //EN baseline value of FEV1 at incidence 

	double           PY= total_packyears_smoked;                       //EN Total packyears smoked    
 
	
 
	double            year_increase_COPD;                              //EN Follow up time   
	double            time_copd_incidence;                             //EN Time of COPD incidence
	double            exac_hazard;                                     //EN hazard of exacerbation
  


	integer          exa_contour={0};    	                 //EN Exa contour
	
	 


//----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
	// Random variables which are defined for each person only once at the point of creation
	
	
	double            x_exac_severity;                       //EN random variable for severity of exacerbation
    double            x_rate_exacerbation_random_effect;     //EN random variable for the rate of exacerbation from AJE paper by Mohsen

	

//-----------------------------------------------------------------------------------------------------------------------------------------

	double            time_exac;          //EN time of exacerbation  
	double            time_exac_exit;     //EN time of exit from exacerbation 
	double            intercept_2;        //EN Intercept of FEV1 slope from Zafar CMAJ   
	
    double            PEF;                //EN Predicted FEV1, calculated using the equation from (NHANES)       
          

	double            FEV1_PEF;           //EN FEV1 percent predicted. This shows the ratio of FEV1 to predicted FEV1 (NHANES) 
	
	
	double            log_Hazard_copd;    //EN log of hazard of copd, by taking exponential of this variable we calculate the probabilty of COPD incidence 
	double            copd_hazard;        //EN copd probability 
	
	double            x_inc_female;       //EN the random term for the baseline FEV1 of incidence cases for female
	double            x_inc_male;         //EN the random term for the baseline FEV1 of incidence cases for male
	double            x_prev_female;      //EN the random term for the baseline FEV1 of prevalence cases for female
	double            x_prev_male;        //EN the random term for the baseline FEV1 of prevalence cases for male


	double            age_base;                     //EN Baseline age for copd incidence cases 
	double            gMass_kg_base;                //EN Baseline weigth for copd incidence cases 
	double            pkyr_base;                    //EN Baseline packyear for copd incidence cases  
	double            RAND_TAIL_FEV1_t ;            //EN Minimum value of FEV1 for each individual, 
	                                                // For each individual, a randome number is defined from a gaussian function, 
	                                                // the mean and standard deviation is coming from analysis of COLD data 
	
	
	double            COPD_mortality_rate;          //EN rate of COPD mortality, as a function of age (coeeficient was provided by Mohsen) and severity of exacerbation (calibration-target --> 10% of severe & very severe exacerbations)
	double            COPD_Mortality_probability;   //EN COPD mortality probability  
	double            p_utility={0.85};             //EN The default utility for no-copd population (weighted age average from  Johnson JA, Pickard AS (2000) Comparison of the EQ-5D and SF-12 health surveys in a general population survey in Alberta, Canada. Med Care 38: 115–121.)
	double            disqualy;                     //EN Disqualy for COPD population stratified by stage 

	COLLAPSED_COPD_STAGE       collapsed_copd_stage = aggregate(copd_stage, COLLAPSED_COPD_STAGE); //EN Collapsed COPD stage         
    COPD_STAGE	               copd_stage = {COPD_STAGE0};                   //EN COPD stage 
	EXAC_STAGE                 exac_stage = {EXAC_STAGE0};                   //EN Exacerbation stage

	


	event            timeCOPDincidence, COPDincidenceEvent;                  //EN COPD Incidence event 
	event            timeCOPDexa, COPDexaEvent;                              //EN Exacerbation event 
	event            timeCOPDexa_exit, COPDexa_exitEvent;                    //EN Exit from exacerbation event    
	event            timeYearsLivedWithCOPDEvent, YearsLivedWithCOPDEvent;   //EN Time lived with COPD event 
                                 
	
	void             FEV1incidence();                                        // EN The function for calculating FEV1 at incidence
    void             FEV1_updateEvent();                                     // EN FEV1 updating function 

	void             copd_check();                                           // Check the log Hazard of COPD and log_Hazard_exa                              
    void             COPD_person_random_variable_FEV1();                     // Provide the random variable for FEV1 baseline ( intercept_1 and intercept_2 )

	double           ComputeXBeta(const double *beta, logical use_base_covar);     // Compute Xbeta for beta/parameter of the form COPD_EQUATION
	
	void             COPD_person_random_variable();    
	hook             COPD_person_random_variable, Start, 50; // 50 = execution number, the higher the value, the later the execution
	
	void             PEF_COPD_Stage();  
	
	void	         COPDPrevalenceStartCheck();
	hook	         COPDPrevalenceStartCheck, Start, 52; // 52 = execution number, the higher the value, the later the execution
//	hook	         COPDPrevalenceStartCheck, BirthdayEvent, 60; // 60 = execution number, the higher the value, the later the execution

	
	void             output_calibration_COPD();
//	hook             output_calibration_COPD,  NewYearsEvent, 10; // 10 = execution number, the higher the value, the later the execution 
	
	void             COPD_mortality();
//	hook             COPD_mortality, Start, 54; // 54 = execution number, the higher the value, the later the execution
	hook             COPD_mortality,COPDexaEvent;  
//	hook             COPD_mortality, NewYearsEvent;


	hook             copd_check,       Start, 56; // 56 = execution number, the higher the value, the later the execution             
	hook             copd_check,       BirthdayEvent, 62; // 62 = execution number, the higher the value, the later the execution    
//	hook             FEV1incidence,    BirthdayEvent;                     // EN Updating FEV1 on the Birthday event  
//	hook             FEV1incidence,    COPDincidenceEvent;                // EN Updating FEV1 on the COPD incidence Event 
	hook	         FEV1_updateEvent, NewYearsEvent, 12;                 // EN Updating FEV1 on the New Year event 

  
 

	hook             PEF_COPD_Stage, Start, 58; // 58 = execution number, the higher the value, the later the execution
//	hook             PEF_COPD_Stage, FEV1incidence;
	hook             PEF_COPD_Stage, FEV1_updateEvent;


	COPD_AGE_RANGE          copd_age_range  = COERCE(COPD_AGE_RANGE,integer_age);  
	COPD_YEAR_RANGE         copd_year_range = COERCE(COPD_YEAR_RANGE,calendar_year); 

	REPORT_TIME_WITH_COPD   time_with_copd = {0};	                      // EN Years lived with COPD

};
//-----------------------------------

void Person::COPD_person_random_variable_FEV1()  // Provide the random variable for FEV1 baseline ( intercept_1 and intercept_2 )
{    
	
	 double mu_intercept_1= 1427.5;      // EN Intercept of FEV1 for baseline FEV1 (Zafar, CMAJ) after Amin's modification 
     double mu_intercept_2= -154.3;      // EN Intercept of rate of FEV1  (Zafar, CMAJ) 
     double var_int_1= 0.1006;           // EN Variance of  Intercept of FEV1 for baseline FEV1 (Zafar, CMAJ) G_matrix[1,1] 
	 double var_int_2= 0.000759;         // EN Variance of  Intercept of rate of FEV1  (Zafar, CMAJ)  G_matrix[2,2] 
  // double cov_int_12= 0.00087;         // EN Covarient of two intercepts  
	 double ro_int_12= 0.099563;         // EN correlation coefficient between two intercepts  (ro=Covarient/sqrt(variance1*variance2)
	
	
	 //Baseline FEV1 from Zafar's CMAJ without intercept plus Amin's modification
      
	 double            FEV1_base_cmaj;     //EN Baseline FEV1 calculated from Zafar CMAJ, it does not include the intercept 
	
	 FEV1_base_cmaj = ComputeXBeta(CopdFev1Base[sex], TRUE) * 0.001;

	 double   z_COPD = FEV1 - FEV1_base_cmaj;     //EN the difference between FEV1_CanCoLD and  FEV1_base_cmaj
	 
	 double            intercept_1;        //EN Intercept of FEV1 from Zafar CMAJ    
	// Conditional Bivariate Normal distribution 
/*	 intercept_1 = RandNormal(141);
	 intercept_2 = ro_int_12*intercept_1+sqrt(1-ro_int_12*ro_int_12)*RandNormal(142);
	 intercept_1 = mu_intercept_1 + sqrt(var_int_1)*intercept_1;
	 intercept_2 = mu_intercept_2 + sqrt((var_int_2)/(var_int_1))*ro_int_12*(z_COPD-mu_intercept_1)+var_int_2*(1-ro_int_12*ro_int_12)*intercept_2 ;
*/	
	 
	  intercept_1 = mu_intercept_1+sqrt(var_int_1)*RandNormal(161); 	 
	  intercept_2 = (mu_intercept_2+sqrt(var_int_2/var_int_1)*ro_int_12*(z_COPD-mu_intercept_1)) + var_int_2*(1-(ro_int_12*ro_int_12))*RandNormal(162);
	
}

