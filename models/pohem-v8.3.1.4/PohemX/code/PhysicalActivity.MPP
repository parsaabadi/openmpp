#include "pohem.h"

//FILE_LABEL (EN) Physical Activity Model
/* FILE_NOTE(EN) 
	This file updates the values (categories) of 4 physical activity variables at two year intervals. 
	  It implements regressions of individual PA evolution observed in the longitudinal 
	  National Population Health Survey (1994-2006). 
	  BEGIN needs to be updated 
	    This module can be deactived using 
	    Intervention Parameters for BMI (see parameter "Risk Factor Control Panel").
	  END needs to be updated 
*/


partition LTPA_4CAT_CUTOFFS { 0.0001, 0.5, 1.0 };
partition METS4CAT			{ 0.0001, 1.5, 3.0 };     //EN METs categories

classification LTPA_4CAT {	     //EN Leisure Time Physical Activity 
	LTPA_NO,                     //EN No physical activity from leisure time
	LTPA_0_30 ,                  //EN 0-30 minutes/day of physical activity from leisure time 
	LTPA_30_60,                  //EN 30-60 minutes/day of physical activity from leisure time 
	LTPA_60_plus                 //EN 60+ minutes/day of physical activity from leisure time 
};
classification BIKE_ERRANDS {    //EN Bikes for errands 
	BIKE_NO,                     //EN Does not bike for errands
	BIKE_YES                     //EN Bikes for errands
};
classification WALK_ERRANDS {    //EN Walks for errands 
	WALK_NO,                     //EN Does not walk for errands
	WALK_0_5 ,                   //EN Walks 0 to 5 hrs/week for errands
	WALK_6_10,                   //EN Walks 6 to 10 hrs/week for errands
	WALK_11_plus                 //EN Walks 11+ hrs/week for errands
};
classification PA_USUAL_DAY {    //EN Level of physical activity for usual day
	SIT,                         //EN Usually sit
	STAND_WALK ,                 //EN Stand or walk quite a lot 
	LIFT,                        //EN Usually lift or carry light loads 
	HEAVY_WORK                   //EN Do heavy work or carry very heavy loads
};

classification PA_INTERVENTION_RECRUITMENT {	//EN Overall program controls
	PAIR_SEX,					//EN	Sex (0=female, 1=male, 2=both) 
	PAIR_AGE_START,				//EN	Age start
	PAIR_AGE_END,				//EN	Age end
	PAIR_YEAR_START,			//EN	Year start
	PAIR_YEAR_END,				//EN	Year end
	PAIR_BMI_LOWER_BOUND,		//EN	BMI lower bound
	PAIR_BMI_UPPER_BOUND,		//EN	BMI upper bound
	PAIR_ASSIGN_IG				//EN	Assign intervention group (1,2,...,5)
};

range	PA_INTERVENTION_ELEMENT { 0, 19 }; //EN Physical activity intervention program element

range   PA_INTERVENTION_GROUP { 1, 5 }; //EN Physical activity intervention group

classification PA_MAIN_LINEAR_PREDICTOR {  //EN Main linear predictors
	PA_MAIN_LP_INTERCEPT, //EN Intercept
	PA_MAIN_LP_CALENDAR_TIME, //EN Calendar time
