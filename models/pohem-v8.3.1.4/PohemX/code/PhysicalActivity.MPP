classification MET_MODEL {   //EN MET model parameters
	MET_MODEL_POWER,         //EN Power transformation
	MET_MODEL_LOCATION ,     //EN Location
	MET_MODEL_SCALE          //EN Scale
};

partition AGE_GROUP_from30_to80_by10	{ 30, 40, 50, 60, 70, 80 }; //EN Age group
partition AGE_GROUP_from30_to80_by5  	{ 30, 35, 40, 45, 50, 55, 60, 65, 70, 75, 80 };//EN Age group



parameter_group pgPA_Parameters{ //EN Physical activity
	pgPA_CONTROL,
	pgPA_Interventions,
	pgPA_Regression 
};

parameter_group pgPA_CONTROL { //EN Physicial activity control parameters
	pgExpertPACONTROL
};

parameter_group pgPA_Interventions { //EN Physicial activity interventions
  PA_intervention,
  PaDispatcher,
  LTPA_4CAT_transition,
  PA_USUAL_DAY_transition,
  WALK_ERRANDS_transition,
  BIKE_ERRANDS_transition,
  pgExpertPAInterventions
};

parameter_group pgPA_Regression { //EN Physical activity regression parameters
 pgExpertPARegression
};

parameter_group pgExpertPACONTROL{ //EN Experts only
	PA_MaxAutoRegressiveOrder,
	PA_BootstrapIndexMultiplier,
	PA_BootstrapOffset,
	LTPA_4CAT_CalendarTimeCap,
	PA_USUAL_DAY_CalendarTimeCap,
	WALK_ERRANDS_CalendarTimeCap,
	BIKE_ERRANDS_CalendarTimeCap
};

parameter_group pgExpertPAInterventions{ //EN Experts only
	Isolate_core_PA
	
};

parameter_group pgExpertPARegression{ //EN Experts only
	LeisureTimeActivityLinearPred,
	BikeErrandsMainLinearPred,
	UsualDayMainLinearPred,
	WalkErrandsMainLinearPred,
	MetDistribution,
	MetCorrelation
};
