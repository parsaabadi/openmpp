//LABEL(PohemVersion, EN) POHEM version number

version 8,3,1,4;



/* NOTE(PohemVersion, EN)
	This module sets the current POHEM version. 
	It is kept in a separate module so that custom models build using POHEM
	can retain the core model and simply replace this file with a more appropriate one.
*/


//LABEL(model, EN) POHEM 8.3.1.4


