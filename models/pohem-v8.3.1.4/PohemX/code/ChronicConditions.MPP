void hook_UpdateBP() {};

void Person::UpdateBP()
{
	gBP_PA = HIGH_BP_YES;  // onset has occured
    BP_hazard=0.0;  // no more onset for now
	UpdateCURE_BP_hazard();   // wakes up clock for return trip

	hook_UpdateBP();
}
