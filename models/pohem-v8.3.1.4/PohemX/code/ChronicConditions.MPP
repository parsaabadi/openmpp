void hook_UpdateCURE_Cancer_hazard() {};

void Person::UpdateCURE_Cancer_hazard()
{
	double linear_predictor=0.0;	

	if (  gCancer == CANCER_YES && CC_hazard_multiplier[CC_CANCER][Cure]) 
	{	
		linear_predictor = ComputeChronicConditionLinearPredictor(CancerCureMainLinearPred[CC_BootstrapIndex], CC_CalendarTimeCap[CC_CANCER][Cure]);
        linear_predictor += CURE_CANCER_Malesex_inter_Clone_age_group_t [CC_BootstrapIndex][sex ]
							  *( SPLIT(truncated_age,AGE_GROUP_from30_to80_by5)+4.0); // add on interaction terms  

        CURE_Cancer_hazard = min(CC_hazard_multiplier[CC_CANCER][Cure] *  exp(linear_predictor)/2.0, CC_hazard_cap[CC_CANCER][Cure] ); 
	}
	else CURE_Cancer_hazard=0.0; 

	hook_UpdateCURE_Cancer_hazard();
};


TIME Person::timeUpdateBP()
{
	TIME event_time = {TIME_INFINITE};  // Time when hypertension onset occurs (gBP_PA switched to HIGH_BP_YES)
	double U;// for debug tracking

	if ( BP_hazard > 0.0 ) // continuous time implementation
	{
		U=RandUniform(96);
		event_time = WAIT( - TIME( log( U ) / BP_hazard ) ); 
	}
	return event_time;
};

TIME Person::timeUpdateDiabetes()
{
	TIME event_time = {TIME_INFINITE};  // Time when Diabetes onset occurs (gDiabetes_PA  switched to DIAB_YES)

	if ( Diabetes_PA_hazard > 0.0 ) // continuous time implementation
	{
		event_time = WAIT( - TIME( log( RandUniform(97) ) / Diabetes_PA_hazard ) ); 
	}
	return event_time;
};


TIME Person::timeUpdateHeartDisease()
{
	TIME event_time = {TIME_INFINITE};  // Time when Heart Disease onset occurs (gHeartDisease_PA  switched to HEART_DISEASE_YES)

	if ( HeartDisease_hazard  > 0.0 ) // continuous time implementation
	{
		event_time = WAIT( - TIME( log( RandUniform(100) ) / HeartDisease_hazard  ) ); 
	}
	return event_time;
};



TIME Person::timeUpdateCancer()
{
	TIME event_time = {TIME_INFINITE};  // Time when Cancer onset occurs (gCancer  switched to CANCER_YES)

	if ( Cancer_hazard  > 0.0 ) // continuous time implementation
	{
		event_time = WAIT( - TIME( log( RandUniform(101) ) / Cancer_hazard  ) ); 
	}
	return event_time;
};

TIME Person::timeUpdateMortality()
{
	TIME event_time = {TIME_INFINITE};  // Time when Death occurs (alive_NPHS  switched to FALSE)

	if ( Mortality_hazard  > 0.0 ) // continuous time implementation
	{  
		/*
        if (truncated_age > 95)		{			event_time = WAIT( 0.5 ); 		}
		else 		{	event_time = WAIT( - TIME( log( RandUniform() ) / Mortality_hazard  ) ); 		}
		*/
		event_time = WAIT( - TIME( log( RandUniform(102) ) / Mortality_hazard  ) ); 
	}
	return event_time;
};


TIME Person::timeUpdateCURE_BP()
{
	TIME event_time = {TIME_INFINITE};  // Time when hypertension cure/remission occurs (gBP_PA switched to HIGH_BP_NO)

	if ( CURE_BP_hazard > 0.0 ) // continuous time implementation
	{
		event_time = WAIT( - TIME( log( RandUniform(103) ) / CURE_BP_hazard ) ); 
	}
	return event_time;
};

