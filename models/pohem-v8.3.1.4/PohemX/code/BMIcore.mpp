double SelfReportedToMeasuredBmi(double sr_bmi, LIFE_SPAN age_of_person, EDUCATION_NA educ_of_person, SEX sexe, double measured_reported_bmi_pivot)
{
	return BMI_MeasuredReportedPivotMean_BMI[sexe] * sr_bmi
		+ BMI_MeasuredReportedPivotMean_Education[sexe][educ_of_person]
		+ BMI_MeasuredReportedPivotMean_AGE[sexe][SPLIT(age_of_person, FROM_25_TO_75_BY_10)]
		+ BMI_MeasuredReportedPivotMean_BMIcat[sexe][SPLIT(sr_bmi, BMI4CAT)]
		+ measured_reported_bmi_pivot*exp(0.5*(BMI_MeasuredReportedPivotVariance_BMI[sexe] * sr_bmi +
			BMI_MeasuredReportedPivotVariance_Education[sexe][educ_of_person])); 
};


double MeasuredToSelfReportedBmi(double measured_bmi, LIFE_SPAN age_of_person, SEX sexe, double measured_reported_bmi_pivot)
{
	return measured_bmi < 0.0 ? measured_bmi
		: (measured_bmi
			- BMI_MeasuredReportedPivotMean_Education[sexe][EDUC_NA_NA]  // Educ not applicable to youth																	
			- BMI_MeasuredReportedPivotMean_AGE[sexe][SPLIT(age_of_person, FROM_25_TO_75_BY_10)]
			- BMI_MeasuredReportedPivotMean_BMIcat[sexe][BMI_STATE_NA_NA]
			- measured_reported_bmi_pivot*exp(0.5*(BMI_MeasuredReportedPivotVariance_BMI[sexe] * measured_bmi
				+ BMI_MeasuredReportedPivotVariance_Education[sexe][EDUC_NA_NA]))
			) / BMI_MeasuredReportedPivotMean_BMI[sexe];
};

void  Person::InitializeBmiStuff()
{
	//MessageWhoWhenWhere(__FUNCTION__, 4==4);
	measured_reported_bmi_pivot = PivotMultiplier * RandLogistic(94) / mgMathConstant_PiOverSqrt3;	

	bmi_history_age  = mgYoungestAge ; 
	bmi_history_year = year ;

	hook_InitializeBmiStuff();
};

void  Person::ReadFromStartPopBMI()
{
	//MessageWhoWhenWhere(__FUNCTION__, 4==4);

	const double *record_to_be_read;
	record_to_be_read = FictivePersonCharacteristics[ROW_1][cDb_Weight] < 0.0 ? pStartPop[cchs_record] : FictivePersonCharacteristics[ROW_1] ;

	double	dBMI;	// BMI value
	dBMI = (double) record_to_be_read[cDb_BMI];
	gBMI = COERCE(BMI_RANGE, dBMI);

	// gBMImeasuredOld = gBMI * pMeanDiffBMIm_sr[sex][bmi-1][age_BMI_group3075];  //delete  it is now a derived state

	CompoundBMIChange();
	
	gBMI_AdultModel = gBMI ;
	gBMI = CalendarTimeAdjustmentBMI(gBMI,pStartPopYear,calendar_year_start);
	gBMI_start = gBMI;

	// Initialize other variables to be used in the transition 
	// of BP, chol and hdl at subsequent ages.
	bmi_previous = bmi;		// bmi is dependent on gBMI set above
	CHHS_bmi     = bmi;
	bmi_start    = bmi; 

	//bmi4cat_measured_start = (BMI_INDEX_ALL_AGES) bmi4cat_measured;          

};



double Person::BuiltInBmiAlteration(double bmi_to_be_altered)
{
	const double *parm_relevant_part = BuiltInBmiAlterationSpecs[sex][SPLIT( truncated_age, FROM_25_TO_80_BY_5)];

	if( parm_relevant_part[BBIAS_SCOPE_YEAR_LOWER_CUTOFF] <= calendar_year     && calendar_year      <= parm_relevant_part[BBIAS_SCOPE_YEAR_UPPER_CUTOFF] &&
		parm_relevant_part[BBIAS_SCOPE_BMI_LOWER_CUTOFF ] <= bmi_to_be_altered && bmi_to_be_altered  <= parm_relevant_part[BBIAS_SCOPE_BMI_UPPER_CUTOFF ] 
	  )
	{
		bmi_to_be_altered  = parm_relevant_part[BBIAS_INTERCEPT ] + parm_relevant_part[BBIAS_SLOPE ] * bmi_to_be_altered;
		
		// correct the resulting BMI value to conform with floor/ceiling restrictions
		double dLowerTrigger = parm_relevant_part[BBIAS_RESULT_LOWER_LIMIT] + parm_relevant_part[BBIAS_RESULT_LOWER_BUFFER]/2;
		double dUpperTrigger = parm_relevant_part[BBIAS_RESULT_UPPER_LIMIT] - parm_relevant_part[BBIAS_RESULT_UPPER_BUFFER]/2;

		if ( bmi_to_be_altered < dLowerTrigger )
			bmi_to_be_altered =	parm_relevant_part[BBIAS_RESULT_LOWER_LIMIT] + RandUniform(141) * parm_relevant_part[BBIAS_RESULT_LOWER_BUFFER];
		else if ( bmi_to_be_altered > dUpperTrigger ) 
			bmi_to_be_altered =	parm_relevant_part[BBIAS_RESULT_UPPER_LIMIT] - RandUniform(142) * parm_relevant_part[BBIAS_RESULT_UPPER_BUFFER];
	
	}

	return bmi_to_be_altered;
};

void Person::UpdateBMINPHS()
{
	//MessageWhoWhenWhere(__FUNCTION__,TRUE);
	// AO: NOTE, this function should not have any return statements in the middle, 
	//     since there are other functions hooked to it, which will not always work
	//     otherwise.

	double	dBMIvalue;
	//int		bmi_ar_order;

	//=================================================
	// Conditions under which BMI models are applied:
	//=================================================

		

	if (
		// 1) BMI updates do not happen every year
		     due_for_biennial_update &&
		   //calendar_year>=calendar_year_start+timing_first_update && ((calendar_year- (calendar_year_start+timing_first_update)) % 2)== 0 &&
		   //truncated_age>=lifespan_age_start +timing_first_update && ((truncated_age- (lifespan_age_start +timing_first_update)) % 2)== 0 &&
		// 2) BMI model can be turned off (for testing the bmi evolution from the Joint Transition Matrix)
		   pRISK_FACTOR_CONTROL_PANEL[cBMI][RF_EVOLUTION_MODEL] &&
		// 3) Model of BMI evolution applies outside of the fixed age range specified here (currently cannot "restart" it)
		   (truncated_age <  pRISK_FACTOR_EVOLUTION_OFF_AGE_RANGE[cBMI][LOWER_BOUND] ||
	 		truncated_age >= pRISK_FACTOR_EVOLUTION_OFF_AGE_RANGE[cBMI][UPPER_BOUND])
		)
	{
		//================================
		// If conditions are met, update BMI according to model selected by user
		//================================

		if ( truncated_age < MAX( LIFE ) ) 
		{
			bmi_ar_order++;
			if ( bmi_ar_order > max_auto_regressive_order - 1 ) 
			{ 
				bmi_ar_order = max_auto_regressive_order-1;
			}
			// COERCE bmi_ar_order to valid index range regardless of input parameter
			bmi_ar_order = COERCE(BMI_AR_ORDER_RANGE, bmi_ar_order);	

			if(BmiFeedBack || BmiModelUserChoice == BMI_MODEL0 )
				bmi_value_at_t_minus_2 = gBMI;

			if ( BmiModelUserChoice == BMI_MODEL0 )  
			{
				dBMIvalue = bmi_value_at_t_minus_2;	
			}
			/* else if ( BmiModelUserChoice == BMI_MODEL1 ) 	
			{
				dBMIvalue = CalculateBMI_Model1( );
			} */
			else if ( BmiModelUserChoice == BMI_MODEL2 ) 	
			{
				dBMIvalue = CalculateBMI_Model2( );	
			}
			else if ( BmiModelUserChoice == BMI_MODEL3 ) 	
			{
				dBMIvalue = CalculateBMI_Model3( );	
			}
			
			// BuiltInBmiAlteration seen as part of the BMINPHS model, so just overwrite dBMIvalue from NPHS equation with the alteration carried out below.
			dBMIvalue = BuiltInBmiAlteration(dBMIvalue) ;

			// Coerce dBMIvalue 
			dBMIvalue = COERCE(BMI_RANGE, dBMIvalue);

			//Affectation globale
			gBMI_AdultModel = dBMIvalue;  
			// gBMImeasuredOld TO REVISE - NOT SATISFYING
			// gBMImeasuredOld = gBMI * pMeanDiffBMIm_sr[sex][bmi-1][age_BMI_group3075];//delete  it is now a derived state

			gBMI_CalendarTimeAdjusted = CalendarTimeAdjustmentBMI(gBMI_AdultModel,pStartPopYear,calendar_year_start);
			gBMI = gBMI_CalendarTimeAdjusted;
		}

	} // End of BMI models applicability conditions

	hook_UpdateBMINPHS();
};

void hook_CompoundBMIChange() {};

void Person::CompoundBMIChange()
{
	double	dCompoundAmount = {0};
	
	// compound change in BMI in the Youngest aged persons in the simulation
	// to simulate a trend in childhood obesity
	dCompoundAmount = pBmiCompoundChange[cCOMPOUND_AMOUNT];

	if ( ( dCompoundAmount != 0 ) &&
		 ( pBmiCompoundChange[cCOMPOUND_START] <= pBmiCompoundChange[cCOMPOUND_END] ) &&
		 ( calendar_year >= pBmiCompoundChange[cCOMPOUND_START] ) &&
		 ( truncated_age == mgYoungestAge ) ) 
	{
		int		nCompoundStartYear = {0};
		int		nCompoundEndYear = {0};
		int		nCompoundYears = {0};

		nCompoundEndYear = (int) pBmiCompoundChange[cCOMPOUND_END];
		nCompoundStartYear = (int) pBmiCompoundChange[cCOMPOUND_START];
		nCompoundStartYear = max( nCompoundStartYear, pStartYear );
		nCompoundYears = min( nCompoundEndYear-nCompoundStartYear, calendar_year-nCompoundStartYear );

		gBMI *= pow(1.0+dCompoundAmount, nCompoundYears);

		// apply floor/ceiling restrictions to resulting BMI
		if ( gBMI < pBmiCompoundChange[cCOMPOUND_FLOOR] )
		{
			gBMI = pBmiCompoundChange[cCOMPOUND_FLOOR];
		}
		else 
		{
			gBMI = min( gBMI, pBmiCompoundChange[cCOMPOUND_CEILING] );
		}
	}

	hook_CompoundBMIChange();
};



double Person::CalendarTimeAdjustmentBMI(double initial_bmi_value, int reference_year, int year_adjusted_to)  
{
	double bmi_altered = initial_bmi_value;

	if(BMI_TimeTravel_Scope[LOWER_BOUND]<=BMI_TimeTravel_Scope[UPPER_BOUND])
	{
		int delta_years;
		
		delta_years= min(max(year_adjusted_to, BMI_TimeTravel_Scope[LOWER_BOUND]),  BMI_TimeTravel_Scope[UPPER_BOUND])      - reference_year;
		
		bmi_altered = (delta_years==0.0) ? initial_bmi_value :
		                        initial_bmi_value*pow(exp(BMI_TimeTravel_Intercept[sex])*pow(initial_bmi_value,BMI_TimeTravel_Slope[sex]),delta_years);
	}
	
	return bmi_altered;
};

void hook_UpdateBMI_InterventionFactor() {};

void Person::UpdateBMI_InterventionFactor()
{
	//MessageWhoWhenWhere(__FUNCTION__,TRUE);

	double tempo={1.0};

	for(int i=0; i<SIZE(BMI_INTERVENTION_FACTOR); i++)
	{
		if(   calendar_year>=pBMI_INTERVENTION[sex][i][BMI_INTERVENTION_MIN_YEAR] 
		   && calendar_year<=pBMI_INTERVENTION[sex][i][BMI_INTERVENTION_MAX_YEAR] 
		   && lifespan_age >=pBMI_INTERVENTION[sex][i][BMI_INTERVENTION_MIN_AGE] 
		   && lifespan_age <=pBMI_INTERVENTION[sex][i][BMI_INTERVENTION_MAX_AGE]	) 
			tempo *=(1.0 + pBMI_ELASTICITY[sex][i]*pBMI_INTERVENTION[sex][i][BMI_INTERVENTION_RELATIVE_CHANGE]);
	}

    gBMI_PhacInterventionFactor=tempo;

	hook_UpdateBMI_InterventionFactor();
}