//FILE_LABEL (EN) Add-on HUI models
/* FILE_NOTE(EN) 
This file includes "Add-on HUI models" for impact of drug use for OA, last visit to OS prior to surgery, and surgeries.
The "Add-on HUI models" are also "added on" to HUI model since it does not explicitly capture this. The same approach
has been taken to add on the effects from these models.

Note that the HUI model 1 code (HUImodel1.mpp) and the Add-on code (found in HUIcore.mpp) has been revised to better organize the updating of HUI. 
For example, the updating of HUI is no longer done inside oa.mpp, but rather in this routine conditional on OA status. The goal is to 
have code that updates HUI in a module devoted to updating HUI. The status of other parts of the model may influence
HUI (eg, change in OA status), but HUI is only changed in here. The exception for the moment in a way, is that we 
HUI model2 is found in a HUImodel2.mpp. HUI model 1 should be removed completely but is left for backward compatibility 
and testing. 

---------------------------------
Previous notes by PF regarding development on impact of drug and the likes on HUI

(2) Distribution du type de médicament (en fonction de l'âge, du sexe et de l'état)
Tirer un nombre au hasard => selon la valeur du nombre et la fonc. cumulative, on obtient le type de médicament
(3) Durée moyenne d'utilisation du type de médicament (en fonction de l'âge, du sexe et de l'état) => NON
(4) Distribution des niveaux de douleur possibles selon niveau de HUI
(5) Réduction de la douleur (proportion en fonction du type de médicament)
L'effet dure seulement pendant que le médicament est utilisé
(6) Risque supplémentaire d'effet secondaire (5 types possibles) en fonction du médicament (par rapport au placebo)
Mais quel est le risque du placebo? => NON
(7) Diminution du HUI en fonction du type d'effet secondaire
La diminution due à la dyspepsie et à l'effet générique dure seulement pendant que le médicament est utilisé;
Cependant, pour le trouble gastro-intestinal, la maladie cardiovasculaire et la "stroke", l'effet dure toute la vie.
(8) Probabilité de décès en fonction du type d'effet secondaire
---------------------------------
*/
#include "pohem.h"

range HUI_PAIN_NBLEVELS {0,4}; // Number of levels of pain in HUI
partition	HUI_AGE_GROUP {20, 30, 40, 50, 60, 70, 80}; //EN Partition of age for computation of delta HUI (except for OS visit)
partition	HUI_AGE_GROUPB {60, 70, 80};				//EN Partition of age for computation of delta HUI for OS visit
partition   HUI_GROUP {0.85, 0.95};						//EN Partition of HUI for drugs +
partition	SIDE_AGE_GROUP {60, 70, 80};				//EN Partition of age for computation of side effct of drugs for differnt age groups
partition   HUI_DISABILITY_GROUP { 0.70 , 0.885 };      //EN HUI group (disability group)
partition FROM_20_TO_80_BY_10 { 20, 30, 40, 50, 60, 70, 80}; //EN Ten year age groups (20-80) 


classification HUI_MODEL_MENU { //EN HUI model menu
	HUI_MODEL_MENU_1,   //EN HUI model 1
	HUI_MODEL_MENU_2,   //EN HUI model 2
	HUI_MODEL_MENU_3    //EN HUI model 3 (recommended)
};

classification OA_DRUG_CYCLE {	//EN Values of time period for which the same drug can be used for the same OA state	
	LESS2Y, // < 2 years
	TWO_5Y, // 2 to 5 years
	MORE5Y  // > 5 years
}; 
classification OA_DRUG_SIDE_EFFECT {// Side effects for type of OA drugs
	GI,		// Gastro-intestinal
	CVD,	// Cardio-vascular disease
	STR,	// Stroke
	DYSPEPSIA,
	OTH_GEN
};

classification OA_DRUG_STATE {	//EN OA state used for drugs only
		NO_OA,				//EN Does not haveOA
		OA_AT_DIAGNOSIS,	//EN OA diagnosis
		OA_OS_VISIT,		//EN OS visit
		OA_PRIMARY_SURGERY, //EN OA primary surgery
		OA_REVISION_SURGERY	//EN OA revision surgery
};

classification OA_DRUG_TYPE {// Type of OA drugs 
	ACETA,	// Acetaminophen
	NSAID,	// NSAIDS
	COXIB,	// COXIB
	OPIOID	// OPIOID
};
parameter_group pgHUI { //EN Health utilities
	HuiModelPreference,
	ReportHuiAsAlteredByOsteoArthritis,
	//pgHuiModel1,
	pgHuiModel2,
	pgHuiModel3,
	pgHuiAddons,
	HUI_Relative_Variation,
	HUIAlterationSpecs
};

parameter_group pgHuiAddons { //EN HUI add-on models for OA (drugs, os visit, surgery) 
	pgHUI_OS,
	pgHUI_OA_Surgery,
	pgHUI_Drug
};
parameter_group pgHUI_Drug { //EN HUI Drug model
Pain,
PainDist,
Drug_PainReduction,
DrugDist,
DrugSideEffect,
SideEffect,
DrugSideEffectMortality
};

parameter_group pgHUI_OS {		//EN HUI OS visit model
pAPPLY_NEW_HUI_MODEL_AT_LAST_OS_VISIT,
HUI_at_os_beta_age,
HUI_at_os_beta_int,
HUI_at_os_beta_scale,
HUI_at_os_beta_sex
};

parameter_group pgHUI_OA_Surgery {		//EN HUI OA surgery model
HUI_post_surg_beta_baseline,
HUI_post_surg_beta_age,
HUI_post_surg_beta_int
};
hide( pAPPLY_NEW_HUI_MODEL_AT_LAST_OS_VISIT); // not used



parameters {

	/* NOTE ( HUI_at_os_beta_age, EN )
	Value of beta for age category used for computation of delta HUI due to 1st or last visit to OS
	From Jacek's team
	*/
	double HUI_at_os_beta_age[HUI_AGE_GROUPB]; // Value of beta for age category used for computation of delta HUI due to 1st or last visit to OS

	/* NOTE ( HUI_at_os_beta_int, EN )
	Value of intercept used for computation of delta HUI due to 1st or last visit to OS
	From Jacek's team
	*/
	double HUI_at_os_beta_int;  // Value of intercept used for computation of delta HUI due to 1st or last visit to OS

	/* NOTE ( HUI_at_os_beta_scale, EN )
	Represents the random noise for model of HUI at 1st or last visit to OS. 
	From Jacek's team
	*/
	double HUI_at_os_beta_scale; // Represents the random noise for model of HUI at 1st or last visit to OS	

	/* NOTE ( HUI_at_os_beta_sex, EN )
	Value of beta for sex used for computation of delta HUI due to 1st or last visit to OS
	From Jacek's team
	*/
	double HUI_at_os_beta_sex[SEX];  // Value of beta for sex used for computation of delta HUI at 1st or last visit to OS	


	/* NOTE ( HUI_post_surg_beta_baseline, EN )
	Value of beta for hui used for computation of delta HUI due to surgery
	From Jacek's team
	*/
	double HUI_post_surg_beta_baseline; // Value of beta for hui used for computation of delta HUI due to surgery
	/* NOTE (HUI_post_surg_beta_age, EN )
	Value of beta for age used for computation of delta HUI due to surgery
	From Jacek's team
	*/
	double HUI_post_surg_beta_age; // Value of beta for age used for computation of delta HUI due to surgery
	/* NOTE ( HUI_post_surg_beta_int, EN )
	Value of intercept used for computation of delta HUI due to surgery
	From Jacek's team
	*/
	double HUI_post_surg_beta_int; // Value of intercept used for computation of delta HUI due to surgery
	/* NOTE ( HUI_Relative_Variation, EN )
	This parameter is used to allow the user include variability (i.e. random noise) in the computation of HUI, 
	at every update of HUI (age, bmi, OA,post-surgery - not os: os has its own random term, HUI_at_os_beta_scale).
	It is set to 0.0 and may be modified by the user.  Values different than 0.0 have not been tested.
	After computation of delta HUI, delta HUI is modified by:
	delta HUI = delta HUI *(1+ Random Normal*HUI_Relative_Variation).
	It is this new value of delta HUI that is added to gHUI_rep to give the updated value of gHUI_rep
	*/
	double HUI_Relative_Variation; // Relative variation of delta HUI

	double  HUIAlterationSpecs[DEMPORT_STATE][SEX][FROM_30_TO_90_BY_10];  //EN HUIAlterationSpecs

	/* NOTE (pAPPLY_NEW_HUI_MODEL_AT_LAST_OS_VISIT,EN)
	This parameter controls when the pre-OA-surgery model of HUI is applied. ThIS model is meant 
	to generate a distribution of HUI values more in-line with those observed prior to surgery for OA. 
	At this time, the history of HUI for this person (based on the NPHS model of change) is suspended
	until post-surgery.
	>TRUE applies it at time of last visit to OS priory to surgery.
	>FALSE applies at first visit to OS.
	*/
	//EN Apply new model of HUI at First (FALSE) or Last (TRUE) OS visit.
	logical pAPPLY_NEW_HUI_MODEL_AT_LAST_OS_VISIT; 

	/* NOTE ( PainDist, EN )
	Distribution of the values of pain for a given maximum value of pain.
	(from Philippe's analysis on CCHS)
	*/
	cumrate PainDist[HUI_PAIN_NBLEVELS][HUI_PAIN_NBLEVELS]; // Distribution of pain by level of pain

	/* NOTE (Drug_PainReduction,EN) 
	Reduction of pain due to drugs 
	*/
	double Drug_PainReduction[OA_DRUG_TYPE]; // Reduction of pain due to drugs 
	/* NOTE (DrugDist,EN)
	Probability of taking drugs for OA patients, conditioned on sex, age, OA state, 
	duration in OA state and by health status (HUI groups).
	Applied independently for each drug.
	*/
	//EN Probability of drug use by OA patients
	double DrugDist[OA_DRUG_TYPE][SEX][OA_SURV_AGE_GROUP][OA_DRUG_STATE][OA_DRUG_CYCLE][HUI_GROUP]; 
	/* NOTE (DrugSideEffect,EN) 
	Relative risk of side effect due to drugs
	*/
	double DrugSideEffect[SIDE_AGE_GROUP][OA_DRUG_TYPE][OA_DRUG_SIDE_EFFECT]; // Relative risk of side effect due to drugs

	/* NOTE ( Pain, EN )
	Values of the coefficient b8 in the computation of HUI (not to be modified)
	*/
	double Pain[HUI_PAIN_NBLEVELS]; // Values of the coefficient b8 in the computation of HUI
	/* NOTE ( SideEffect, EN )
	Average deterioration of HUI by type of side effect
	From Jacek's team
	*/
	double SideEffect[OA_DRUG_SIDE_EFFECT]; // Average deterioration of HUI by type of side effect
	double DrugSideEffectMortality[OA_DRUG_SIDE_EFFECT]; //EN Mortality due to drugs
	
	//EN Select HUI model 2 by checking the box (uncheck to use HUI model 1 for backwards compatibility)

	int HuiModelPreference[HUI_MODEL_MENU]; //EN Give highest score to HUI model to be reported and give positive scores to HUI models to be run (negative scores not allowed)
	model_generated HUI_MODEL_MENU mgHuiModelToReport ;
	logical ReportHuiAsAlteredByOsteoArthritis; //EN Report on HUI as altered by add-ons for OA

};

// Overall HUI state variables for person
actor Person            // Core Individual
{
//	double 	gHUI_rep = ( HUIModel2Chosen ) ? gHUI_model2_person_coerced : gHUI_model1_person_coerced ;
	double  gHUI_rep_temp    = ReportHuiAsAlteredByOsteoArthritis ? gHUI_coerced_rep : gHUI_model_rep;
	double 	gHUI_rep         = gHUI_rep_temp * HUIAlterationSpecs[dementia][sex][split(lifespan_age, FROM_30_TO_90_BY_10)];

	double 	gHUI_model_rep   =  ( mgHuiModelToReport == HUI_MODEL_MENU_2 ) ? double(gHUI_model2 )
							   : double(gHUI_model3) ;
	double 	gHUI_coerced_rep =  ( mgHuiModelToReport == HUI_MODEL_MENU_2 ) ? double(gHUI_model2_person_coerced )
							   : double(gHUI_model3_person_coerced) ;

	int  	disability_group = split(gHUI_rep, HUI_DISABILITY_GROUP); //EN Disability group

	//double 	gHUI_model1_person = gHUI_model1 + delta_HUI_Drugs_model1 + delta_HUI_OA_OS_model1 + delta_HUI_OA_surg_model1;	// Add-ons calculated for model 1
	double 	gHUI_model2_person = gHUI_model2 + delta_HUI_Drugs_model2 + delta_HUI_OA_OS_model2 + delta_HUI_OA_surg_model2;  // Add-ons calculated for model 2
	double 	gHUI_model3_person = gHUI_model3 + delta_HUI_Drugs_model3 + delta_HUI_OA_OS_model3 + delta_HUI_OA_surg_model3;  // Add-ons calculated for model 3

	//double 	gHUI_model1_person_coerced = CoerceHUI( gHUI_model1_person ); 
	double 	gHUI_model2_person_coerced = CoerceHUI( gHUI_model2_person );
	double 	gHUI_model3_person_coerced = CoerceHUI( gHUI_model3_person );

	void    ReadFromStartPopHui();                
	hook    ReadFromStartPopHui,ReadFromStartPop, 80; // 80 = execution number, the higher the value, the later the execution

	void    ReadFromStartPopHuiComponents();                //move this to the mpp in charge of the HUI components model
	hook    ReadFromStartPopHuiComponents,ReadFromStartPop, 90; // 90 = execution number, the higher the value, the later the execution //move this to the mpp in charge of the HUI components model

};


double CoerceHUI( double dHUI )
{
	double dHUI_coerced = ( dHUI > 1.0 ) ? 1.0 : ( dHUI < -0.36 ) ? -0.36 : dHUI ; 
	return dHUI_coerced;
};

void hook_ReadFromStartPopHui() {};

void Person::ReadFromStartPopHui() 
{
	//MessageWhoWhenWhere(__FUNCTION__, 4==4);
	const double *record_to_be_read;
	record_to_be_read = FictivePersonCharacteristics[ROW_1][cDb_Weight] < 0.0 ? pStartPop[cchs_record] : FictivePersonCharacteristics[ROW_1] ;

	// Initialize HUI index
	gHUI_model2 =  (double) record_to_be_read[cDb_HUI]; //keep the 99.999 (if any) for now
	gHUI_model3 = gHUI_model2; //same deal for model3
	gHUI = CoerceHUI( gHUI_model2 ); //but coerce initial value for model 1

	hook_ReadFromStartPopHui();
};

