user_table utPresimView //EN Some PreSimulation calculation 
{
	{
		A0, //EN Number of in scope records in StartPop db
		C0, //EN mgNumCasesRaw[cStartPop]    Weights of in scope records in StartPop db
		C1, //EN mgNumCasesRaw[cNewBirth]    New Births (subsequent years) 
		C2, //EN mgNumCasesRaw[cNewImmig]    New Immigrants (subsequent years) 
		E0, //EN mgNumCases[cStartPop]       Weights of in scope records in StartPop db
		E1, //EN mgNumCases[cNewBirth]       New Births (subsequent years) 
		E2, //EN mgNumCases[cNewImmig]       New Immigrants (subsequent years) 
		E4, //EN mgNewImmigAdjustFactor     decimals=9
		E5, //EN mgNewBirthAdjustFactor     decimals=9
		E6, //EN mgNewBirthAdjustFactorUnduplicate  decimals=9
		E7, //EN mgNewBirthAdjustFactorReduceAim    decimals=9
		E8, //EN Number of cases                   decimals=9
		E9, //EN Number of Canadians               decimals=9
		E10 //EN Number of Canadians per case      decimals=9
	}
	*
	DUMMY_ROW_OR_COLUMN
};

